+// A2-09
+bool UserProcess::copyOnWrite(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+  if (m.page_size != PAGE_SIZE)
+    return false;
+  PageTableEntry& pte = m.pt[m.pti];
+  if (pte.page_ppn != ArchMemory::shared_zero_ppn_)
+    return pte.writeable;                      // another thread already copied it: just retry
+  // the copy of a zero page is a fresh page: allocPPN zeroes it (generic COW: memcpy here)
+  pte.page_ppn = PageManager::instance()->allocPPN();
+  pte.writeable = 1;
+  ArchMemory::flushTlb();                      // the TLB may still map vpn -> zero page
+  return true;
+}
