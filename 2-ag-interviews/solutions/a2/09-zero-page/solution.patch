+size_t ArchMemory::shared_zero_ppn_ = 0;
+static char shared_zero_page[PAGE_SIZE] __attribute__((aligned(PAGE_SIZE)));   // A2-09
+
+void ArchMemory::initSharedZeroPage()
+{
+  memset(shared_zero_page, 0, PAGE_SIZE);
+  size_t vpn = (size_t) shared_zero_page / PAGE_SIZE;
+  size_t ppn = 0;
+  size_t page_size = get_PPN_Of_VPN_In_KernelMapping(vpn, &ppn);
+  assert(page_size && "kernel page not mapped");
+  // the kernel may be mapped with 2 MiB pages: then ppn counts 2 MiB frames
+  size_t pages_per_frame = page_size / PAGE_SIZE;
+  shared_zero_ppn_ = ppn * pages_per_frame + vpn % pages_per_frame;
+}
