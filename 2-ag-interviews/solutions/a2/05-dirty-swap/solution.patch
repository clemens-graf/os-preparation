new file mode 100644
index 00000000..7a643489
--- /dev/null
+++ b/common/include/mm/SwapManager.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include "types.h"
+
+class Mutex;
+class Bitmap;
+class BDVirtualDevice;
+
+/**
+ * A2-01: page-sized slots on the swap partition idea2.
+ * Slot s lies at byte offset s * PAGE_SIZE of the partition.
+ */
+class SwapManager
+{
+  public:
+    static SwapManager* instance();
+    static void init();                         // from startup(), after the block devices exist
+
+    /** copies physical page ppn into a free slot @return the slot, or -1 if the device is full */
+    size_t writeOut(size_t ppn);
+    /** copies slot into physical page ppn */
+    void readIn(size_t slot, size_t ppn);
+    void freeSlot(size_t slot);
+    size_t usedSlots();
+
+    /** A2-05: copies ppn into an already reserved slot (the old copy is outdated) */
+    void writeSlot(size_t slot, size_t ppn);
+    /** A2-05: number of pages written to disk so far */
+    size_t writes();
+
+    static void freeSlotCallback(size_t slot);  // for ArchMemory::forEachSwappedPage
+
+  private:
+    SwapManager();
+    static SwapManager* instance_;
+
+    BDVirtualDevice* device_;
+    size_t num_slots_;
+    Bitmap* slots_;          // bit set = slot in use
+    Mutex* lock_;            // protects slots_ and serialises our disk requests
+    size_t writes_;          // A2-05: protected by lock_
+};
