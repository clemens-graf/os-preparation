+
+// A2-01
+size_t UserProcess::swapOut(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);               // your team's page-table lock
+  ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;                       // not mapped (or already swapped out)
+  PageTableEntry& pte = m.pt[m.pti];
+  size_t ppn = pte.page_ppn;
+
+  // 1. take the page away from the process FIRST - otherwise another thread could write to
+  //    it while it is being copied, and the copy on disk would be torn
+  pte.present = 0;
+  ArchMemory::flushTlb();
+  // 2. copy it to disk. We keep holding thread_lock_: a thread that touches the page now
+  //    page-faults and waits for the lock in swapIn
+  //    A2-05: unless there is a copy on disk already and the page was not written since.
+  //    The dirty bit is read AFTER present = 0 + TLB flush: no write can set it any more.
+  size_t slot;
+  if (pte.ignored_1 && !pte.dirty)
+    slot = pte.ignored_1 - 1;                 // clean: the disk copy is still correct
+  else if (pte.ignored_1)
+  {
+    slot = pte.ignored_1 - 1;                 // dirty: overwrite its old slot, no new one
+    SwapManager::instance()->writeSlot(slot, ppn);
+  }
+  else
+  {
+    slot = SwapManager::instance()->writeOut(ppn);
+    if (slot == (size_t) -1)
+    {
+      pte.present = 1;                        // device full: undo
+      return (size_t) -1;
+    }
+  }
+  pte.ignored_1 = 0;
+  // 3. the entry now says "swapped, at slot" - present stays 0
+  pte.page_ppn = slot;
+  pte.ignored_2 = PTE_SWAPPED;
+  PageManager::instance()->freePPN(ppn);
+  return 0;
+}
+
+bool UserProcess::swapIn(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+  if (m.page_size == PAGE_SIZE)
+    return true;                              // another thread swapped it in while we waited
+  if (!m.pt || m.pt[m.pti].ignored_2 != PTE_SWAPPED)
+    return false;                             // never swapped: a normal page fault
+  PageTableEntry& pte = m.pt[m.pti];
+  size_t slot = pte.page_ppn;
+  size_t ppn = PageManager::instance()->allocPPN();   // lock order: thread_lock_ -> PageManager
+  SwapManager::instance()->readIn(slot, ppn);         // -> SwapManager: always this order
+  // A2-05: keep the slot - its content equals the page until the page is written
+  pte.ignored_1 = slot + 1;
+  pte.dirty = 0;                              // was not present: no TLB entry can hold an old dirty bit
+  pte.ignored_2 = 0;
+  pte.page_ppn = ppn;
+  pte.present = 1;                            // last: only now may the process use it again
+  return true;
+}
