diff --git a/common/source/mm/SwapManager.cpp b/common/source/mm/SwapManager.cpp
new file mode 100644
index 00000000..ba6badb9
--- /dev/null
+++ b/common/source/mm/SwapManager.cpp
@@ -0,0 +1,91 @@
+#include "SwapManager.h"
+#include "BDManager.h"
+#include "BDVirtualDevice.h"
+#include "ArchMemory.h"
+#include "Bitmap.h"
+#include "Mutex.h"
+#include "ScopeLock.h"
+#include "kprintf.h"
+#include "assert.h"
+
+SwapManager* SwapManager::instance_ = nullptr;
+
+void SwapManager::init()
+{
+  instance_ = new SwapManager();
+}
+
+SwapManager* SwapManager::instance()
+{
+  assert(instance_ && "SwapManager::init() was not called in startup()");
+  return instance_;
+}
+
+SwapManager::SwapManager() : device_(BDManager::getInstance()->getDeviceByName("idea2")),
+                             num_slots_(0), slots_(nullptr), lock_(new Mutex("SwapManager::lock_")), writes_(0)
+{
+  assert(device_ && "no swap partition idea2");
+  num_slots_ = (size_t) device_->getNumBlocks() * device_->getBlockSize() / PAGE_SIZE;
+  if (num_slots_ > 2047)
+    num_slots_ = 2047;     // A2-05: slot + 1 must fit into the 11 bits of ignored_1
+  slots_ = new Bitmap(num_slots_);
+  debug(PM, "SwapManager: %zu slots on %s\n", num_slots_, device_->getName());
+}
+
+size_t SwapManager::writeOut(size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  size_t slot = 0;
+  while (slot < num_slots_ && slots_->getBit(slot))
+    ++slot;
+  if (slot == num_slots_)
+    return (size_t) -1;
+  slots_->setBit(slot);
+  // the driver reads the page through its kernel (ident) address - the page does not need
+  // to be mapped anywhere, and it is not: the caller has already unmapped it
+  int32 written = device_->writeData(slot * PAGE_SIZE, PAGE_SIZE, (char*) ArchMemory::getIdentAddressOfPPN(ppn));
+  assert(written == PAGE_SIZE && "swap write failed");
+  ++writes_;
+  return slot;
+}
+
+void SwapManager::readIn(size_t slot, size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  assert(slots_->getBit(slot) && "reading a free swap slot");
+  int32 read = device_->readData(slot * PAGE_SIZE, PAGE_SIZE, (char*) ArchMemory::getIdentAddressOfPPN(ppn));
+  assert(read == PAGE_SIZE && "swap read failed");
+}
+
+void SwapManager::freeSlot(size_t slot)
+{
+  ScopeLock lock(*lock_);
+  assert(slots_->getBit(slot) && "double free of a swap slot");
+  slots_->unsetBit(slot);
+}
+
+size_t SwapManager::usedSlots()
+{
+  ScopeLock lock(*lock_);
+  return slots_->getNumBitsSet();
+}
+
+void SwapManager::freeSlotCallback(size_t slot)
+{
+  instance()->freeSlot(slot);
+}
+
+void SwapManager::writeSlot(size_t slot, size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  assert(slots_->getBit(slot) && "writing a slot that is not reserved");
+  int32 written = device_->writeData(slot * PAGE_SIZE, PAGE_SIZE, (char*) ArchMemory::getIdentAddressOfPPN(ppn));
+  assert(written == PAGE_SIZE && "swap write failed");
+  ++writes_;
+}
+
+size_t SwapManager::writes()
+{
+  ScopeLock lock(*lock_);
+  return writes_;
+}
