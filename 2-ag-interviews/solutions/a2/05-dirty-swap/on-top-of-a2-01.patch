+
+void SwapManager::writeSlot(size_t slot, size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  assert(slots_->getBit(slot) && "writing a slot that is not reserved");
+  int32 written = device_->writeData(slot * PAGE_SIZE, PAGE_SIZE, (char*) ArchMemory::getIdentAddressOfPPN(ppn));
+  assert(written == PAGE_SIZE && "swap write failed");
+  ++writes_;
+}
+
+size_t SwapManager::writes()
+{
+  ScopeLock lock(*lock_);
+  return writes_;
+}
