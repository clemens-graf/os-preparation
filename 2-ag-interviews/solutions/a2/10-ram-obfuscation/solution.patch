diff --git a/common/source/kernel/ObfuscationThread.cpp b/common/source/kernel/ObfuscationThread.cpp
new file mode 100644
index 00000000..87fdcfae
--- /dev/null
+++ b/common/source/kernel/ObfuscationThread.cpp
@@ -0,0 +1,39 @@
+#include "ObfuscationThread.h"
+#include "UserProcess.h"
+#include "Scheduler.h"
+#include "Mutex.h"
+#include "ScopeLock.h"
+#include "kprintf.h"
+
+ObfuscationThread::ObfuscationThread() : Thread(0, "ObfuscationThread", Thread::KERNEL_THREAD), random_(12345)
+{
+}
+
+size_t ObfuscationThread::nextRandom()
+{
+  random_ = random_ * 6364136223846793005ULL + 1442695040888963407ULL;   // LCG
+  return random_ >> 33;
+}
+
+void ObfuscationThread::Run()
+{
+  while (true)
+  {
+    size_t until = Scheduler::instance()->getTicks() + 2;
+    while (Scheduler::instance()->getTicks() < until)
+      Scheduler::instance()->yield();
+
+    // lock order: all_processes_lock_ -> one process' thread_lock_ (taken in relocatePage)
+    ScopeLock lock(*UserProcess::all_processes_lock_);
+    size_t count = 0;
+    for (UserProcess* p = UserProcess::all_processes_; p; p = p->next_process_)
+      ++count;
+    if (count == 0)
+      continue;
+    size_t pick = nextRandom() % count;
+    UserProcess* process = UserProcess::all_processes_;
+    while (pick--)
+      process = process->next_process_;
+    process->relocatePage(nextRandom());
+  }
+}
