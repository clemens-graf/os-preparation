new file mode 100644
index 0000000..c44fb9e
--- /dev/null
+++ b/common/source/kernel/ObfuscationThread.cpp
@@ -0,0 +1,39 @@
+#include "ObfuscationThread.h"
+#include "Loader.h"
+#include "Scheduler.h"
+#include "Mutex.h"
+#include "ScopeLock.h"
+#include "kprintf.h"
+
+ObfuscationThread::ObfuscationThread() : Thread(0, "ObfuscationThread", Thread::KERNEL_THREAD), random_(12345)
+{
+}
+
+size_t ObfuscationThread::nextRandom()
+{
+  random_ = random_ * 6364136223846793005ULL + 1442695040888963407ULL;   // LCG
+  return random_ >> 33;
+}
+
+void ObfuscationThread::Run()
+{
+  while (true)
+  {
+    size_t until = Scheduler::instance()->getTicks() + 2;
+    while (Scheduler::instance()->getTicks() < until)
+      Scheduler::instance()->yield();
+
+    // lock order: all_loaders_lock_ -> one loader's arch_memory_lock_ (taken in relocatePage)
+    ScopeLock lock(*Loader::all_loaders_lock_);
+    size_t count = 0;
+    for (Loader* l = Loader::all_loaders_; l; l = l->next_loader_)
+      ++count;
+    if (count == 0)
+      continue;
+    size_t pick = nextRandom() % count;
+    Loader* loader = Loader::all_loaders_;
+    while (pick--)
+      loader = loader->next_loader_;
+    loader->relocatePage(nextRandom());
+  }
+}
