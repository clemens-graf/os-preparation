+// A2-10
+bool UserProcess::relocatePage(size_t index)
+{
+  const size_t MAX = 256;
+  size_t vpns[MAX];
+  ScopeLock lock(thread_lock_);
+  size_t count = arch_memory_->collectPresentPages(vpns, MAX);
+  if (count == 0)
+    return false;
+  ArchMemoryMapping m = arch_memory_->resolveMapping(vpns[index % count]);
+  PageTableEntry& pte = m.pt[m.pti];
+  size_t old_ppn = pte.page_ppn;
+
+  // 1. the process must not use the page while it is copied: a write to the OLD page during
+  //    the copy would be lost. Take it away first - an access now page-faults, and the page
+  //    fault handler waits for thread_lock_ (see isMapped).
+  pte.present = 0;
+  ArchMemory::flushTlb();
+  // 2. copy through the ident mapping
+  size_t new_ppn = PageManager::instance()->allocPPN();
+  memcpy((void*) ArchMemory::getIdentAddressOfPPN(new_ppn), (void*) ArchMemory::getIdentAddressOfPPN(old_ppn), PAGE_SIZE);
+  // 3. point the entry to the new page and give it back
+  pte.page_ppn = new_ppn;
+  pte.present = 1;
+  PageManager::instance()->freePPN(old_ppn);
+  ++relocations_;
+  return true;
+}
+
+bool UserProcess::isMapped(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  return arch_memory_->resolveMapping(vpn).page_size == PAGE_SIZE;
+}
