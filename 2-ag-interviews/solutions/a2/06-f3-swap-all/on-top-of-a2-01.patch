+size_t Loader::swapOutAll()
+{
+  // collect first, swap out afterwards: swapOut takes arch_memory_lock_ itself, and it changes
+  // the tables we would be walking
+  const size_t MAX = 512;
+  size_t* vpns = new size_t[MAX];
+  arch_memory_lock_.acquire();
+  size_t count = arch_memory_.collectPresentPages(vpns, MAX);
+  arch_memory_lock_.release();
+  size_t swapped = 0;
+  for (size_t i = 0; i < count; ++i)
+    swapped += swapOut(vpns[i]) == 0;     // a page may be gone meanwhile: then swapOut says -1
+  delete[] vpns;
+  return swapped;
+}
