@@ -0,0 +1,35 @@
+#pragma once
+
+#include "types.h"
+
+class Mutex;
+
+// A2-03: swapped-out pages live on the KERNEL HEAP instead of the swap device.
+// The kernel heap is small and the kernel itself needs it: at most this many pages.
+#define HEAP_SWAP_SLOTS 64
+
+/**
+ * A2-01/A2-03: slots for swapped-out pages - here: page-sized buffers on the kernel heap
+ */
+class SwapManager
+{
+  public:
+    static SwapManager* instance();
+    static void init();
+
+    /** copies physical page ppn into a free slot @return the slot, or -1 if all slots are used */
+    size_t writeOut(size_t ppn);
+    /** copies slot into physical page ppn */
+    void readIn(size_t slot, size_t ppn);
+    void freeSlot(size_t slot);
+    size_t usedSlots();
+
+    static void freeSlotCallback(size_t slot);  // for ArchMemory::forEachSwappedPage
+
+  private:
+    SwapManager();
+    static SwapManager* instance_;
+
+    char* buffers_[HEAP_SWAP_SLOTS];   // nullptr = slot free
+    Mutex* lock_;                      // protects buffers_
+};
