diff --git a/common/source/mm/SwapManager.cpp b/common/source/mm/SwapManager.cpp
new file mode 100644
index 0000000..a22552e
--- /dev/null
+++ b/common/source/mm/SwapManager.cpp
@@ -0,0 +1,66 @@
+#include "SwapManager.h"
+#include "ArchMemory.h"
+#include "Mutex.h"
+#include "ScopeLock.h"
+#include "kstring.h"
+#include "kprintf.h"
+#include "assert.h"
+
+SwapManager* SwapManager::instance_ = nullptr;
+
+void SwapManager::init()
+{
+  instance_ = new SwapManager();
+}
+
+SwapManager* SwapManager::instance()
+{
+  assert(instance_ && "SwapManager::init() was not called in startup()");
+  return instance_;
+}
+
+SwapManager::SwapManager() : buffers_(), lock_(new Mutex("SwapManager::lock_"))
+{
+}
+
+size_t SwapManager::writeOut(size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  size_t slot = 0;
+  while (slot < HEAP_SWAP_SLOTS && buffers_[slot])
+    ++slot;
+  if (slot == HEAP_SWAP_SLOTS)
+    return (size_t) -1;                 // limit reached: better fail than exhaust the kernel heap
+  buffers_[slot] = new char[PAGE_SIZE]; // kernel heap (KernelMemoryManager has its own lock)
+  memcpy(buffers_[slot], (void*) ArchMemory::getIdentAddressOfPPN(ppn), PAGE_SIZE);
+  return slot;
+}
+
+void SwapManager::readIn(size_t slot, size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  assert(slot < HEAP_SWAP_SLOTS && buffers_[slot] && "reading a free swap slot");
+  memcpy((void*) ArchMemory::getIdentAddressOfPPN(ppn), buffers_[slot], PAGE_SIZE);
+}
+
+void SwapManager::freeSlot(size_t slot)
+{
+  ScopeLock lock(*lock_);
+  assert(slot < HEAP_SWAP_SLOTS && buffers_[slot] && "double free of a swap slot");
+  delete[] buffers_[slot];
+  buffers_[slot] = nullptr;
+}
+
+size_t SwapManager::usedSlots()
+{
+  ScopeLock lock(*lock_);
+  size_t used = 0;
+  for (char* buffer : buffers_)
+    used += buffer != nullptr;
+  return used;
+}
+
+void SwapManager::freeSlotCallback(size_t slot)
+{
+  instance()->freeSlot(slot);
+}
