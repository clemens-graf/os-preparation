diff --git a/common/source/kernel/UserProcess.cpp b/common/source/kernel/UserProcess.cpp
index f37eb7ef..27a96761 100644
--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -10,7 +10,9 @@
 #include "Scheduler.h"
 #include "UserThread.h"
 #include "Mutex.h"
+#include "ScopeLock.h"
 #include "ArchMemory.h"
+#include "syscall-definitions.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -550,3 +552,32 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A2-12
+bool UserProcess::isBlacklisted(size_t syscall_number)
+{
+  // even a read needs the lock: another thread may be adding an entry right now
+  ScopeLock lock(blacklist_lock_);
+  for (size_t i = 0; i < blacklist_count_; ++i)
+  {
+    if (blacklist_[i] == syscall_number)
+      return true;
+  }
+  return false;
+}
+
+size_t UserProcess::addToBlacklist(size_t syscall_number)
+{
+  if (syscall_number == sc_exit)
+    return (size_t) -1;                 // a process that cannot exit would live forever
+  ScopeLock lock(blacklist_lock_);
+  for (size_t i = 0; i < blacklist_count_; ++i)
+  {
+    if (blacklist_[i] == syscall_number)
+      return 0;                         // already blocked
+  }
+  if (blacklist_count_ == MAX_BLACKLIST)
+    return (size_t) -1;
+  blacklist_[blacklist_count_++] = syscall_number;
+  return 0;
+}
