+  }
   if ((syscall_number != sc_sched_yield) && (syscall_number != sc_outline)) // no debug print because these might occur very often
   {
     debug(SYSCALL, "Syscall %zd called with arguments %zd(=%zx) %zd(=%zx) %zd(=%zx) %zd(=%zx) %zd(=%zx)\n",
@@ -114,6 +121,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_blacklist:
+      return_value = currentThread->getProcess()->addToBlacklist(arg1);
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
