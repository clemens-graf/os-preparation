@@ -22,6 +22,13 @@
 size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2, size_t arg3, size_t arg4, size_t arg5)
 {
   size_t return_value = 0;
+
+  // A2-12: a blocked syscall is not executed at all
+  if (currentThread->getProcess() && currentThread->getProcess()->isBlacklisted(syscall_number))
+  {
+    debug(SYSCALL, "syscall %zu is blacklisted for %s\n", syscall_number, currentThread->getName());
