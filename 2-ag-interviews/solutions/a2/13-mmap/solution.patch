+
+// A2-13: same values as in userspace/libc/include/sys/mman.h
+#define MMAP_PROT_WRITE 0x2
+#define MMAP_MAP_ANONYMOUS 0x80000000
+
+// A2-13: only anonymous mappings (no file): reserve the pages, map them on first access
+size_t Syscall::mmap(size_t length, size_t prot, size_t flags, size_t fd)
+{
+  if (length == 0 || length > (1ULL << 30) || !(flags & MMAP_MAP_ANONYMOUS) || fd != (size_t) -1)
+    return (size_t) -1;
+  size_t pages = (length + PAGE_SIZE - 1) / PAGE_SIZE;
+  return currentThread->getProcess()->mmapAnonymous(pages, prot & MMAP_PROT_WRITE);
+}
diff --git a/common/source/kernel/UserProcess.cpp b/common/source/kernel/UserProcess.cpp
index e32f2cda..98eab733 100644
--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -10,6 +10,7 @@
 #include "Scheduler.h"
 #include "UserThread.h"
 #include "Mutex.h"
+#include "ScopeLock.h"
 #include "ArchMemory.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
@@ -600,3 +601,64 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A2-13
+size_t UserProcess::mmapAnonymous(size_t pages, bool writeable)
+{
+  ScopeLock lock(thread_lock_);
+  for (MmapRegion& region : mmap_regions_)
+  {
+    if (region.start_vpn)
+      continue;
+    region.start_vpn = mmap_next_vpn_;
+    region.pages = pages;
+    region.writeable = writeable;
+    mmap_next_vpn_ += pages + 1;             // + 1: an unmapped gap between two mappings
+    return region.start_vpn * PAGE_SIZE;     // nothing mapped: the page fault handler does it
+  }
+  return (size_t) -1;                        // no free region entry
+}
+
+size_t UserProcess::munmap(size_t address, size_t pages)
+{
+  ScopeLock lock(thread_lock_);
+  for (MmapRegion& region : mmap_regions_)
+  {
+    if (!region.start_vpn || region.start_vpn * PAGE_SIZE != address || region.pages != pages)
+      continue;
+    for (size_t vpn = region.start_vpn; vpn < region.start_vpn + region.pages; ++vpn)
+    {
+      if (arch_memory_->resolveMapping(vpn).page_size != 0)
+        arch_memory_->unmapPage(vpn);        // also frees the physical page
+    }
+    ArchMemory::flushTlb();                  // rights removed: no stale TLB entry may survive
+    region.start_vpn = 0;
+    return 0;
+  }
+  return (size_t) -1;
+}
+
+bool UserProcess::mapMmapPage(size_t vpn)
+{
+  size_t ppn = PageManager::instance()->allocPPN();   // zeroed, before the lock
+  thread_lock_.acquire();
+  bool inside = false, mapped = false;
+  for (MmapRegion& region : mmap_regions_)
+  {
+    if (region.start_vpn && vpn >= region.start_vpn && vpn < region.start_vpn + region.pages)
+    {
+      inside = true;                         // check and map in ONE critical section:
+      mapped = arch_memory_->mapPage(vpn, ppn, 1);   // munmap may remove the region otherwise
+      if (mapped && !region.writeable)
+      {
+        ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+        m.pt[m.pti].writeable = 0;           // still under the lock: nobody saw it writable
+      }
+      break;
+    }
+  }
+  thread_lock_.release();
+  if (!mapped)
+    PageManager::instance()->freePPN(ppn);   // outside every region, or another thread was faster
+  return inside;
+}
