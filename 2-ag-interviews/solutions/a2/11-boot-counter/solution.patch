diff --git a/common/source/kernel/BootRecord.cpp b/common/source/kernel/BootRecord.cpp
new file mode 100644
index 0000000..c0d0708
--- /dev/null
+++ b/common/source/kernel/BootRecord.cpp
@@ -0,0 +1,61 @@
+#include "BootRecord.h"
+#include "BDManager.h"
+#include "BDVirtualDevice.h"
+#include "Mutex.h"
+#include "ScopeLock.h"
+#include "kstring.h"
+#include "kprintf.h"
+#include "assert.h"
+
+BootRecord* BootRecord::instance_ = nullptr;
+
+void BootRecord::init()
+{
+  instance_ = new BootRecord();
+}
+
+BootRecord* BootRecord::instance()
+{
+  return instance_;
+}
+
+BootRecord::BootRecord() : device_(BDManager::getInstance()->getDeviceByName("idea2")),
+                           lock_(new Mutex("BootRecord::lock_"))
+{
+  assert(device_);
+  // disk I/O waits for the IDE interrupt and yields meanwhile: this needs a running thread with
+  // interrupts on - so init() is called by the ProcessRegistry thread, not in startup()
+  int32 read = device_->readData(0, sizeof(record_), (char*) &record_);
+  assert(read == sizeof(record_));
+  if (record_.magic != MAGIC)           // fresh disk: start counting
+  {
+    memset(&record_, 0, sizeof(record_));
+    record_.magic = MAGIC;
+  }
+  ++record_.boot_count;
+  int32 written = device_->writeData(0, sizeof(record_), (char*) &record_);
+  assert(written == sizeof(record_));
+  record_.motd[MOTD_SIZE - 1] = 0;
+  kprintf("This is boot number %zu. Message of the day: %s\n", (size_t) record_.boot_count,
+          record_.motd[0] ? record_.motd : "(none)");
+}
+
+size_t BootRecord::bootCount()
+{
+  ScopeLock lock(*lock_);
+  return record_.boot_count;
+}
+
+void BootRecord::getMotd(char* buffer)
+{
+  ScopeLock lock(*lock_);
+  memcpy(buffer, record_.motd, MOTD_SIZE);
+}
+
+bool BootRecord::setMotd(const char* text)
+{
+  ScopeLock lock(*lock_);              // two processes setting it at once: one record, one write
+  strncpy(record_.motd, text, MOTD_SIZE - 1);
+  record_.motd[MOTD_SIZE - 1] = 0;
+  return device_->writeData(0, sizeof(record_), (char*) &record_) == sizeof(record_);
+}
