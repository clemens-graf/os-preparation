diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 178fc3a2..b9a67620 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,8 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "kstring.h"
+#include "BootRecord.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -92,6 +94,15 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
+    case sc_bootcount:
+      return_value = BootRecord::instance()->bootCount();
+      break;
+    case sc_getmotd:
+      return_value = getMotd(arg1);
+      break;
+    case sc_setmotd:
+      return_value = setMotd(arg1);
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -540,3 +551,26 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A2-11
+size_t Syscall::getMotd(size_t user_buffer)
+{
+  if (user_buffer == 0 || user_buffer > USER_BREAK - MOTD_SIZE)
+    return (size_t) -1;
+  char motd[MOTD_SIZE];
+  BootRecord::instance()->getMotd(motd);
+  memcpy((void*) user_buffer, motd, MOTD_SIZE);
+  return 0;
+}
+
+size_t Syscall::setMotd(size_t user_text)
+{
+  if (user_text == 0 || user_text > USER_BREAK - MOTD_SIZE)
+    return (size_t) -1;
+  char text[MOTD_SIZE];
+  memcpy(text, (void*) user_text, MOTD_SIZE);    // copy in (at most MOTD_SIZE bytes) ...
+  text[MOTD_SIZE - 1] = 0;                       // ... and terminate the copy ourselves
+  if (!BootRecord::instance()->setMotd(text))
+    return (size_t) -1;
+  return 0;
+}
