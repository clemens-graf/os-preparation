diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 964cd5b..05fa0b7 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -7,6 +7,8 @@
 #include "ProcessRegistry.h"
 #include "File.h"
 #include "Scheduler.h"
+#include "BootRecord.h"
+#include "kstring.h"
 
 size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2, size_t arg3, size_t arg4, size_t arg5)
 {
@@ -49,6 +51,15 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pseudols:
       pseudols((const char*) arg1, (char*) arg2, arg3);
       break;
+    case sc_bootcount:
+      return_value = BootRecord::instance()->bootCount();
+      break;
+    case sc_getmotd:
+      return_value = getMotd(arg1);
+      break;
+    case sc_setmotd:
+      return_value = setMotd(arg1);
+      break;
     default:
       return_value = -1;
       kprintf("Syscall::syscallException: Unimplemented Syscall Number %zd\n", syscall_number);
@@ -181,3 +192,24 @@ void Syscall::trace()
   currentThread->printBacktrace();
 }
 
+
+// A2-11
+size_t Syscall::getMotd(size_t user_buffer)
+{
+  if (user_buffer == 0 || user_buffer >= USER_BREAK - MOTD_SIZE)
+    return (size_t) -1;
+  char motd[MOTD_SIZE];
+  BootRecord::instance()->getMotd(motd);
+  memcpy((void*) user_buffer, motd, MOTD_SIZE);
+  return 0;
+}
+
+size_t Syscall::setMotd(size_t user_text)
+{
+  if (user_text == 0 || user_text >= USER_BREAK - MOTD_SIZE)
+    return (size_t) -1;
+  char text[MOTD_SIZE];
+  memcpy(text, (void*) user_text, MOTD_SIZE);    // copy in (at most MOTD_SIZE bytes) ...
+  text[MOTD_SIZE - 1] = 0;                       // ... and terminate the copy ourselves
+  return BootRecord::instance()->setMotd(text) ? 0 : (size_t) -1;
+}
