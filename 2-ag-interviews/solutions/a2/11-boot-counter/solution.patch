diff --git a/common/include/kernel/BootRecord.h b/common/include/kernel/BootRecord.h
new file mode 100644
index 00000000..52fd96cd
--- /dev/null
+++ b/common/include/kernel/BootRecord.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "types.h"
+
+class Mutex;
+class BDVirtualDevice;
+
+#define MOTD_SIZE 256
+
+/**
+ * A2-11: block 0 of the swap partition idea2 holds a boot counter and a message of the day
+ * that survive reboots.
+ */
+class BootRecord
+{
+  public:
+    static void init();                 // from ProcessRegistry::Run(): needs a thread (disk I/O)
+    static BootRecord* instance();
+
+    size_t bootCount();
+    void getMotd(char* buffer);         // MOTD_SIZE bytes, 0-terminated
+    bool setMotd(const char* text);     // kernel copy, written to disk at once
+
+  private:
+    BootRecord();
+    static BootRecord* instance_;
+
+    struct OnDisk                       // exactly one 512-byte block
+    {
+      uint64 magic;
+      uint64 boot_count;
+      char motd[MOTD_SIZE];
+      char unused[512 - 16 - MOTD_SIZE];
+    };
+    static_assert(sizeof(OnDisk) == 512, "the record must be one block");
+    static const uint64 MAGIC = 0x5357454242304F54ULL;   // "SWEBB0OT"
+
+    BDVirtualDevice* device_;
+    Mutex* lock_;                       // protects record_ and the disk block
+    OnDisk record_;
+};
