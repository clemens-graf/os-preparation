+
+// A2-07: same values as PROT_* in userspace/libc/include/sys/mman.h
+#define PROT_READ_BIT 0x1
+#define PROT_WRITE_BIT 0x2
+#define PROT_EXEC_BIT 0x4
+
+size_t Syscall::mprotect(size_t address, size_t length, size_t prot)
+{
+  size_t pages = (length + PAGE_SIZE - 1) / PAGE_SIZE;
+  if (address % PAGE_SIZE != 0 || length == 0 || address >= USER_BREAK || pages > (USER_BREAK - address) / PAGE_SIZE)
+    return (size_t) -1;
+  if ((prot & PROT_WRITE_BIT) && (prot & PROT_EXEC_BIT))
+    return (size_t) -1;                                  // W xor X: never writable AND executable
+
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());              // your team's page-table lock
+  ArchMemory& memory = process->getAddressSpace();
+  size_t first = address / PAGE_SIZE;
+  // all or nothing: check every page before changing any
+  for (size_t vpn = first; vpn < first + pages; ++vpn)
+  {
+    if (memory.resolveMapping(vpn).page_size != PAGE_SIZE)
+      return (size_t) -1;                                // not present (lazy pages: touch them first)
+  }
+  for (size_t vpn = first; vpn < first + pages; ++vpn)
+  {
+    ArchMemoryMapping m = memory.resolveMapping(vpn);
+    PageTableEntry& pte = m.pt[m.pti];
+    pte.user_access = prot != 0;                         // PROT_NONE: only the kernel may touch it
+    pte.writeable = (prot & PROT_WRITE_BIT) != 0;        // x86: writable implies readable
+    pte.execution_disabled = (prot & PROT_EXEC_BIT) == 0; // NX bit - works, EFER.NXE is on
+  }
+  ArchMemory::flushTlb();                                // rights may have been REMOVED
+  return 0;
+}
