+size_t Loader::swapOut(size_t vpn)
+{
+  ScopeLock lock(arch_memory_lock_);
+  ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;                       // not mapped (or already swapped out)
+  PageTableEntry& pte = m.pt[m.pti];
+  size_t ppn = pte.page_ppn;
+
+  // 1. take the page away from the process FIRST - otherwise another thread could write to
+  //    it while it is being copied, and the copy on disk would be torn
+  pte.present = 0;
+  ArchMemory::flushTlb();
+  // 2. copy it to disk. We keep holding arch_memory_lock_: a thread that touches the page now
+  //    page-faults and waits for the lock in swapIn
+  size_t slot = SwapManager::instance()->writeOut(ppn);
+  if (slot == (size_t) -1)
+  {
+    pte.present = 1;                          // device full: undo
+    return (size_t) -1;
+  }
+  // 3. the entry now says "swapped, at slot" - present stays 0
+  pte.page_ppn = slot;
+  pte.ignored_2 = PTE_SWAPPED;
+  PageManager::instance()->freePPN(ppn);
+  return 0;
+}
+
+bool Loader::swapIn(size_t vpn)
+{
+  ScopeLock lock(arch_memory_lock_);
+  ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+  if (m.page_size == PAGE_SIZE)
+    return true;                              // another thread swapped it in while we waited
+  if (!m.pt || m.pt[m.pti].ignored_2 != PTE_SWAPPED)
+    return false;                             // never swapped: a normal page fault
+  PageTableEntry& pte = m.pt[m.pti];
+  size_t slot = pte.page_ppn;
+  size_t ppn = PageManager::instance()->allocPPN();   // lock order: arch_memory_lock_ -> PageManager
+  SwapManager::instance()->readIn(slot, ppn);         // -> SwapManager: always this order
+  SwapManager::instance()->freeSlot(slot);
+  pte.ignored_2 = 0;
+  pte.page_ppn = ppn;
+  pte.present = 1;                            // last: only now may the process use it again
+  return true;
+}
+
+size_t Loader::createPageBackup(size_t vpn)
+{
+  ScopeLock lock(arch_memory_lock_);
+  ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;                        // not present: nothing to back up
+  PageBackup* entry = nullptr;
+  for (PageBackup& backup : backups_)
+  {
+    if (backup.vpn == vpn)
+      entry = &backup;                         // existing backup: overwrite its slot
+  }
+  if (!entry)
+  {
+    for (PageBackup& backup : backups_)
+    {
+      if (!entry && backup.vpn == 0)
+        entry = &backup;
+    }
+    if (!entry)
+      return (size_t) -1;                      // table full
+    size_t slot = SwapManager::instance()->allocSlot();
+    if (slot == (size_t) -1)
+      return (size_t) -1;
+    entry->vpn = vpn;
+    entry->slot = slot;
+  }
+  // the page stays present: we write it through its ident address while holding the
+  // page-table lock (so it cannot be swapped out or unmapped meanwhile)
+  SwapManager::instance()->writeSlot(entry->slot, m.page_ppn);
+  return 0;
+}
+
+size_t Loader::loadPageBackup(size_t vpn)
+{
+  ScopeLock lock(arch_memory_lock_);
+  for (PageBackup& backup : backups_)
+  {
+    if (backup.vpn != vpn)
+      continue;
+    ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+    if (m.page_size != PAGE_SIZE)
+      return (size_t) -1;                      // swapped out / unmapped since
+    SwapManager::instance()->readIn(backup.slot, m.page_ppn);   // overwrite the page in place
+    return 0;                                  // the backup stays: it can be loaded again
+  }
+  return (size_t) -1;
+}
