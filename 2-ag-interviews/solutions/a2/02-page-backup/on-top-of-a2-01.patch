   return true;
 }
+
+// A2-02
+size_t UserProcess::createPageBackup(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;                        // not present: nothing to back up
+  PageBackup* entry = nullptr;
+  for (PageBackup& backup : backups_)
+  {
+    if (backup.vpn == vpn)
+      entry = &backup;                         // existing backup: overwrite its slot
+  }
+  if (!entry)
+  {
+    for (PageBackup& backup : backups_)
+    {
+      if (!entry && backup.vpn == 0)
+        entry = &backup;
+    }
+    if (!entry)
+      return (size_t) -1;                      // table full
+    size_t slot = SwapManager::instance()->allocSlot();
+    if (slot == (size_t) -1)
+      return (size_t) -1;
+    entry->vpn = vpn;
+    entry->slot = slot;
+  }
+  // the page stays present: we write it through its ident address while holding the
+  // page-table lock (so it cannot be swapped out or unmapped meanwhile)
+  SwapManager::instance()->writeSlot(entry->slot, m.page_ppn);
+  return 0;
+}
+
+size_t UserProcess::loadPageBackup(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  for (PageBackup& backup : backups_)
+  {
+    if (backup.vpn != vpn)
+      continue;
+    ArchMemoryMapping m = arch_memory_->resolveMapping(vpn);
+    if (m.page_size != PAGE_SIZE)
+      return (size_t) -1;                      // swapped out / unmapped since
+    SwapManager::instance()->readIn(backup.slot, m.page_ppn);   // overwrite the page in place
+    return 0;                                  // the backup stays: it can be loaded again
+  }
+  return (size_t) -1;
+}
diff --git a/common/source/mm/SwapManager.cpp b/common/source/mm/SwapManager.cpp
index f96581e0..3b7f9e8e 100644
--- a/common/source/mm/SwapManager.cpp
+++ b/common/source/mm/SwapManager.cpp
@@ -71,3 +71,23 @@ void SwapManager::freeSlotCallback(size_t slot)
 {
   instance()->freeSlot(slot);
 }
+
+size_t SwapManager::allocSlot()
+{
+  ScopeLock lock(*lock_);
+  size_t slot = 0;
+  while (slot < num_slots_ && slots_->getBit(slot))
+    ++slot;
+  if (slot == num_slots_)
+    return (size_t) -1;
+  slots_->setBit(slot);
+  return slot;
+}
+
+void SwapManager::writeSlot(size_t slot, size_t ppn)
+{
+  ScopeLock lock(*lock_);
+  assert(slots_->getBit(slot) && "writing a slot that is not reserved");
+  int32 written = device_->writeData(slot * PAGE_SIZE, PAGE_SIZE, (char*) ArchMemory::getIdentAddressOfPPN(ppn));
+  assert(written == PAGE_SIZE && "backup write failed");
+}
