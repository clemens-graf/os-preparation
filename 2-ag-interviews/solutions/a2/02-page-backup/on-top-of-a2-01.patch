+// A2-02
+size_t Syscall::pageBackup(size_t address, bool load)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+  Loader* loader = currentThread->loader_;
+  return load ? loader->loadPageBackup(address / PAGE_SIZE) : loader->createPageBackup(address / PAGE_SIZE);
+}
