+
+void SwapManager::crypt(char* page)
+{
+  uint64* words = (uint64*) page;
+  for (size_t i = 0; i < PAGE_SIZE / sizeof(uint64); ++i)
+    words[i] ^= key_[i % 2];             // 128 bit key = two 64-bit words, repeated over the page
+}
+
+void SwapManager::readRaw(size_t slot, char* buffer, size_t size)
+{
+  ScopeLock lock(*lock_);
+  char* block = new char[PAGE_SIZE];
+  int32 read = device_->readData(slot * PAGE_SIZE, PAGE_SIZE, block);
+  assert(read == PAGE_SIZE);
+  memcpy(buffer, block, size);
+  delete[] block;
 }
 
