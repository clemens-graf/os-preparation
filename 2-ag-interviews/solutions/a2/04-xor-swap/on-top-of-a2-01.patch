+bool Loader::peekSwapped(size_t vpn, char* buffer, size_t size)
+{
+  ScopeLock lock(arch_memory_lock_);
+  ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+  if (!m.pt || m.pt[m.pti].present || m.pt[m.pti].ignored_2 != PTE_SWAPPED)
+    return false;
+  SwapManager::instance()->readRaw(m.pt[m.pti].page_ppn, buffer, size);
+  return true;
+}
