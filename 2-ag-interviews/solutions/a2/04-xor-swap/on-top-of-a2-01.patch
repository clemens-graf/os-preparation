+// A2-04 (testing): the first 16 bytes on disk of the swapped-out page at address
+size_t Syscall::swapPeek(size_t address, size_t user_buffer)
+{
+  if (address >= USER_BREAK || user_buffer == 0 || user_buffer >= USER_BREAK - 16)
+    return (size_t) -1;
+  char raw[16];
+  if (!currentThread->loader_->peekSwapped(address / PAGE_SIZE, raw, sizeof(raw)))
+    return (size_t) -1;
+  memcpy((void*) user_buffer, raw, sizeof(raw));
+  return 0;
+}
