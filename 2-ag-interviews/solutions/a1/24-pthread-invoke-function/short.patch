diff --git a/common/include/kernel/UserThread.h b/common/include/kernel/UserThread.h
index 14e8bd79..ee15718b 100644
--- a/common/include/kernel/UserThread.h
+++ b/common/include/kernel/UserThread.h
@@ -9,6 +9,11 @@ class UserProcess;
 class UserThread : public Thread
 {
 public:
+  // A1-24 (thread_lock_): a call another thread asked for, and the registers to come back to
+  size_t invoke_function_ = 0, invoke_arg_ = 0, invoke_trampoline_ = 0;
+  bool invoke_running_ = false;
+  size_t invoke_saved_[19];          // rip ... r15: the first 19 words of ArchThreadRegisters
+
   UserThread() = delete;
 
   UserThread(UserProcess* process, ustl::string name, uint32 terminal_number,
diff --git a/common/include/kernel/syscall-definitions.h b/common/include/kernel/syscall-definitions.h
index 290b5459..9384d3ed 100644
--- a/common/include/kernel/syscall-definitions.h
+++ b/common/include/kernel/syscall-definitions.h
@@ -44,6 +44,8 @@
 #define sc_pthread_detach 1504
 #define sc_pthread_setcancelstate 1505
 #define sc_pthread_setcanceltype 1506
+#define sc_pthread_invoke_function 1631
+#define sc_pthread_invoke_return 1632
 #define sc_thread_count 1998
 #define sc_process_count 1999
 #define PTHREAD_CANCELED ((void*) -1)
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..860cc7fb 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,9 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "ScopeLock.h"
+#include "ArchThreads.h"
+#include "kstring.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +117,29 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_invoke_function:            // only store the request
+    {
+      ScopeLock lock(process->getThreadLock());   // findThreadData + the target's invoke_* fields
+      UserThreadData* data = process->findThreadData(arg1);
+      if (!arg2 || !data || !data->thread_ || data->thread_ == currentThread || data->thread_->invoke_function_)
+      {
+        return_value = -1;
+        break;
+      }
+      data->thread_->invoke_function_ = arg2;
+      data->thread_->invoke_arg_ = arg3;
+      data->thread_->invoke_trampoline_ = arg4;
+      break;
+    }
+    case sc_pthread_invoke_return:              // back from the function: restore everything
+    {
+      UserThread* self = (UserThread*) currentThread;
+      ScopeLock lock(process->getThreadLock());   // the invoke_* fields
+      memcpy(self->user_registers_, self->invoke_saved_, sizeof(self->invoke_saved_));
+      self->invoke_running_ = false;
+      return_value = self->user_registers_->rax;   // the interrupted syscall's result
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -166,6 +192,27 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
       debug(WARN, "unimplemented syscall %zd\n", syscall_number);
       kprintf("Syscall::syscallException: Unimplemented Syscall Number %zd\n", syscall_number);
   }
+  UserThread* self = (UserThread*) currentThread;   // A1-24: a pending call runs when this thread leaves the kernel
+  if (process)
+  {
+    ScopeLock process_lock(process->getProcessLock());   // checkAddressValid: page tables first,
+    ScopeLock lock(process->getThreadLock());            // then the invoke_* fields
+    ArchThreadRegisters* regs = self->user_registers_;
+    size_t rsp = regs->rsp - 128;                   // below the red zone
+    rsp = rsp - rsp % 16 - 8;                       // like after a call: rsp % 16 == 8
+    pointer slot = self->invoke_function_ && !self->invoke_running_ ? process->getAddressSpace().checkAddressValid(rsp) : 0;
+    if (slot)
+    {
+      regs->rax = return_value;                     // saved with the registers
+      memcpy(self->invoke_saved_, regs, sizeof(self->invoke_saved_));
+      *(size_t*) slot = self->invoke_trampoline_;   // the function returns into the trampoline
+      regs->rsp = rsp;
+      regs->rip = self->invoke_function_;
+      regs->rdi = self->invoke_arg_;
+      self->invoke_function_ = 0;
+      self->invoke_running_ = true;
+    }
+  }
   return return_value;
 }
 
diff --git a/userspace/libc/include/pthread.h b/userspace/libc/include/pthread.h
index acdce2f0..65019415 100644
--- a/userspace/libc/include/pthread.h
+++ b/userspace/libc/include/pthread.h
@@ -40,6 +40,8 @@ extern int pthread_join(pthread_t thread, void **value_ptr);
 
 extern int pthread_detach(pthread_t thread);
 
+extern int pthread_invoke_function(pthread_t thread, void (*function)(void*), void* arg);
+
 extern int pthread_mutex_init(pthread_mutex_t *mutex,
                               const pthread_mutexattr_t *attr);
 
diff --git a/userspace/libc/src/pthread.c b/userspace/libc/src/pthread.c
index 75e67a42..2e887ec1 100644
--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -240,3 +240,20 @@ int pthread_setcanceltype(int type, int *oldtype)
   }
   return __syscall(sc_pthread_setcanceltype, (size_t)type, (size_t)oldtype, 0x00, 0x00, 0x00);
 }
+
+void __pthread_invoke_finish(void)
+{
+  __syscall(sc_pthread_invoke_return, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
+
+__asm__(".globl __pthread_invoke_trampoline\n"
+        "__pthread_invoke_trampoline:\n"
+        "  call __pthread_invoke_finish\n");     // the call fixes the stack alignment
+
+void __pthread_invoke_trampoline(void);
+
+int pthread_invoke_function(pthread_t thread, void (*function)(void*), void* arg)
+{
+  return __syscall(sc_pthread_invoke_function, thread, (size_t) function, (size_t) arg,
+                   (size_t) __pthread_invoke_trampoline, 0x00);
+}
