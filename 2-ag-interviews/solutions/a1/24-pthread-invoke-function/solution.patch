diff --git a/common/source/kernel/UserProcess.cpp b/common/source/kernel/UserProcess.cpp
index e32f2cda..bcdb7fdc 100644
--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -600,3 +600,69 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A1-24
+size_t UserProcess::invokeFunction(size_t tid, size_t function, size_t arg, size_t trampoline)
+{
+  if (function == 0 || function >= USER_BREAK || trampoline == 0 || trampoline >= USER_BREAK)
+    return (size_t) -1;
+  ScopeLock lock(thread_lock_);
+  if (tid == currentThread->getTID())
+    return (size_t) -1;
+  UserThreadData* data = findThreadDataByTid(tid);
+  if (!data || !data->thread_)
+    return (size_t) -1;                       // unknown, or already ended
+  UserThread* thread = data->thread_;
+  if (thread->invoke_function_ != 0)
+    return (size_t) -1;                       // one pending call at a time
+  thread->invoke_function_ = function;
+  thread->invoke_arg_ = arg;
+  thread->invoke_trampoline_ = trampoline;
+  return 0;
+}
+
+void UserProcess::deliverInvoke(size_t return_value)
+{
+  UserThread* thread = static_cast<UserThread*>(currentThread);
+  ScopeLock lock(thread_lock_);
+  if (thread->invoke_function_ == 0 || thread->invoke_running_)
+    return;
+  ArchThreadRegisters* regs = thread->user_registers_;
+  size_t rsp = regs->rsp - 128;               // skip the red zone of the interrupted code
+  rsp = rsp - rsp % 16 - sizeof(size_t);      // like after a call: rsp % 16 == 8
+  pointer slot = arch_memory_->checkAddressValid(rsp);
+  if (!slot)
+  {
+    thread->invoke_function_ = 0;             // stack page not mapped: drop the call
+    return;
+  }
+  SavedUserRegisters& saved = thread->invoke_saved_;
+  saved.rip = regs->rip; saved.rflags = regs->rflags; saved.rax = return_value;
+  saved.rcx = regs->rcx; saved.rdx = regs->rdx; saved.rbx = regs->rbx; saved.rsp = regs->rsp;
+  saved.rbp = regs->rbp; saved.rsi = regs->rsi; saved.rdi = regs->rdi; saved.r8 = regs->r8;
+  saved.r9 = regs->r9; saved.r10 = regs->r10; saved.r11 = regs->r11; saved.r12 = regs->r12;
+  saved.r13 = regs->r13; saved.r14 = regs->r14; saved.r15 = regs->r15;
+  *(size_t*) slot = thread->invoke_trampoline_;   // the function returns into the trampoline
+  regs->rsp = rsp;
+  regs->rip = thread->invoke_function_;
+  regs->rdi = thread->invoke_arg_;
+  thread->invoke_function_ = 0;
+  thread->invoke_running_ = true;
+}
+
+size_t UserProcess::invokeReturn()
+{
+  UserThread* thread = static_cast<UserThread*>(currentThread);
+  ScopeLock lock(thread_lock_);
+  if (!thread->invoke_running_)
+    return (size_t) -1;
+  SavedUserRegisters& saved = thread->invoke_saved_;
+  ArchThreadRegisters* regs = thread->user_registers_;
+  regs->rip = saved.rip; regs->rflags = saved.rflags; regs->rcx = saved.rcx; regs->rdx = saved.rdx;
+  regs->rbx = saved.rbx; regs->rsp = saved.rsp; regs->rbp = saved.rbp; regs->rsi = saved.rsi;
+  regs->rdi = saved.rdi; regs->r8 = saved.r8; regs->r9 = saved.r9; regs->r10 = saved.r10;
+  regs->r11 = saved.r11; regs->r12 = saved.r12; regs->r13 = saved.r13; regs->r14 = saved.r14;
+  regs->r15 = saved.r15;
+  thread->invoke_running_ = false;
+  return saved.rax;                           // lands in rax: the interrupted syscall's result
+}
