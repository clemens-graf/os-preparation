 class UserProcess;
 
+// A1-24: the user registers a thread had before it was sent into an invoked function
+struct SavedUserRegisters
+{
+  uint64 rip, rflags, rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi, r8, r9, r10, r11, r12, r13, r14, r15;
+};
+
 class UserThread : public Thread
 {
 public:
+  // A1-24 (thread_lock_ of the process): a call another thread asked this thread to make
+  size_t invoke_function_ = 0;       // 0 = nothing pending
+  size_t invoke_arg_ = 0;
+  size_t invoke_trampoline_ = 0;     // where the function returns to (libc)
+  bool invoke_running_ = false;      // inside the invoked function right now
+  SavedUserRegisters invoke_saved_;  // the registers to go back to afterwards
+
   UserThread() = delete;
 
   UserThread(UserProcess* process, ustl::string name, uint32 terminal_number,
