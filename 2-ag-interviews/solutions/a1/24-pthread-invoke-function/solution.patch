diff --git a/userspace/libc/src/pthread.c b/userspace/libc/src/pthread.c
index 8b8448e4..4b2363f6 100644
--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -231,3 +231,22 @@ int pthread_setcanceltype(int type, int *oldtype)
 {
   return -1;
 }
+
+// A1-24: the invoked function returns here (ret pops this address); the call keeps the stack
+// aligned for the C function, which asks the kernel to restore the thread's old registers
+void __pthread_invoke_finish(void)
+{
+  __syscall(sc_pthread_invoke_return, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
+
+__asm__(".globl __pthread_invoke_trampoline\n"
+        "__pthread_invoke_trampoline:\n"
+        "  call __pthread_invoke_finish\n");
+
+extern void __pthread_invoke_trampoline(void);
+
+int pthread_invoke_function(pthread_t thread, void (*function)(void*), void* arg)
+{
+  return __syscall(sc_pthread_invoke_function, (size_t)thread, (size_t)function, (size_t)arg,
+                   (size_t)__pthread_invoke_trampoline, 0x00);
+}
