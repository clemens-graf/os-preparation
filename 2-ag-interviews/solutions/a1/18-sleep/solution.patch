index 178fc3a2..b1ca1c02 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -92,6 +92,12 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
+    case sc_sleep:
+      return_value = sleep(arg1);
+      break;
+    case sc_uptime:
+      return_value = Scheduler::instance()->getTicks();
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -540,3 +546,15 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-18: the timer interrupt counts ticks (Scheduler::incTicks), 1193180 / 65536 = 18.2 per second.
+// Wait until enough ticks have passed - giving the CPU away meanwhile, so other threads run.
+size_t Syscall::sleep(size_t seconds)
+{
+  if (seconds > 100000)
+    seconds = 100000;                                       // no overflow below
+  size_t until = Scheduler::instance()->getTicks() + seconds * 182 / 10;
+  while (Scheduler::instance()->getTicks() < until)
+    Scheduler::instance()->yield();                         // never wait while holding a lock
+  return 0;                                                 // POSIX: seconds left unslept = 0
+}
