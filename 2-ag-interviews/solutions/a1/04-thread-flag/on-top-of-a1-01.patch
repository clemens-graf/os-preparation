+// A1-04: flag a thread of the calling process (0 = main thread)
+size_t Syscall::pthreadSetDouble(size_t thread_id, size_t on)
+{
+  UserProcess* process = currentThread->process_;
+  ScopeLock lock(process->getThreadsLock());   // keeps the thread object alive while we use it
+  Thread* thread = process->findThread(thread_id);
+  if (!thread)
+    return (size_t) -1;
+  ArchThreads::atomic_set((uint64&) thread->double_slice_, on ? 1 : 0);   // the scheduler may read it any moment
+  return 0;
+}
