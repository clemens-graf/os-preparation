diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..38458a04 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,7 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +115,18 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_setdouble:
+    {
+      ScopeLock lock(currentThread->getProcess()->getThreadLock());
+      UserThreadData* data = currentThread->getProcess()->findThreadData(arg1);
+      if (!data || !data->thread_)
+      {
+        return_value = -1;
+        break;
+      }
+      data->thread_->double_slice_ = arg2;
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
