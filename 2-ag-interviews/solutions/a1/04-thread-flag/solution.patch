       break;
@@ -540,3 +545,20 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-04: flag a thread of the calling process (0 = the calling thread)
+size_t Syscall::pthreadSetDouble(size_t thread_id, size_t on)
+{
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());   // exitThread clears thread_ under this lock:
+  Thread* thread = currentThread;             // the object stays alive while we hold it
+  if (thread_id != 0)
+  {
+    UserThreadData* thread_data = process->findThreadDataByTid(thread_id);
+    if (!thread_data || !thread_data->thread_)
+      return (size_t) -1;                     // unknown, or already exited
+    thread = thread_data->thread_;
+  }
+  ArchThreads::atomic_set((uint64&) thread->double_slice_, on ? 1 : 0);   // the scheduler may read it any moment
+  return 0;
+}
