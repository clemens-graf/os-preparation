--- a/common/source/kernel/Scheduler.cpp
+++ b/common/source/kernel/Scheduler.cpp
@@ -64,6 +64,23 @@ void Scheduler::schedule()
     currentThread->setToDestroy();
   }
 
+  // A1-04: a flagged thread keeps the CPU for a second time slice
+  if (currentThread != nullptr)
+  {
+    bool flagged = currentThread->double_slice_;
+    bool had_extra_slice = currentThread->extra_slice_used_;
+    if (flagged && !had_extra_slice && currentThread->schedulable())
+    {
+      currentThread->extra_slice_used_ = 1;          // the second slice starts now
+      if (currentThread->switch_to_userspace_)
+        currentThreadRegisters = currentThread->user_registers_;
+      else
+        currentThreadRegisters = currentThread->kernel_registers_;
+      return;                                        // no switch: the same thread goes on
+    }
+    currentThread->extra_slice_used_ = 0;            // it loses the CPU: next time two slices again
+  }
+
   auto it = threads_.begin();
   for(; it != threads_.end(); ++it)
   {
