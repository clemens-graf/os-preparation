@@ -448,3 +457,43 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-03: a pthread_barrier_t in user space holds the id of a kernel barrier
+static bool readBarrierId(size_t barrier_ptr, size_t* id)
+{
+  if (barrier_ptr == 0 || barrier_ptr > USER_BREAK - sizeof(size_t))
+    return false;
+  *id = *(size_t*) barrier_ptr;                 // copy in once, then only use the copy
+  return true;
+}
+
+size_t Syscall::barrierInit(size_t barrier_ptr, size_t count)
+{
+  if (count == 0 || barrier_ptr == 0 || barrier_ptr > USER_BREAK - sizeof(size_t))
+    return (size_t) -1;
+  *(size_t*) barrier_ptr = 0;                   // touch first: fault before a barrier is allocated
+  size_t id = currentThread->getProcess()->barrierInit(count);
+  if (id == (size_t) -1)
+    return (size_t) -1;
+  *(size_t*) barrier_ptr = id;
+  return 0;
+}
+
+size_t Syscall::barrierWait(size_t barrier_ptr)
+{
+  size_t id;
+  if (!readBarrierId(barrier_ptr, &id))
+    return (size_t) -1;
+  return currentThread->getProcess()->barrierWait(id);
+}
+
+size_t Syscall::barrierDestroy(size_t barrier_ptr)
+{
+  size_t id;
+  if (!readBarrierId(barrier_ptr, &id))
+    return (size_t) -1;
+  size_t result = currentThread->getProcess()->barrierDestroy(id);
+  if (result == 0)
+    *(size_t*) barrier_ptr = 0;
+  return result;
+}
