-  thread_lock_("UserProcess::thread_lock"), thread_exited_(&thread_lock_, "UserProcess::thread_exited_"), next_stack_slot_lock_("UserProcess::next_stack_slot_lock"), running_threads_(0), next_stack_slot_(0)
+  thread_lock_("UserProcess::thread_lock"), thread_exited_(&thread_lock_, "UserProcess::thread_exited_"), next_stack_slot_lock_("UserProcess::next_stack_slot_lock"), running_threads_(0), next_stack_slot_(0),
+  barriers_lock_("UserProcess::barriers_lock_"), barrier_opened_(&barriers_lock_, "UserProcess::barrier_opened_")
 {
+  for (Barrier& barrier : barriers_)   // A1-03
+    barrier.used = false;
   debug(USERPROCESS, "created process with ppid: %zu, pid: %zu, filename: %s, terminal_number: %d, file descriptor: %d\n", ppid_, pid_, filename_.c_str(), terminal_number_, fd_);
 }
 
@@ -550,3 +554,50 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A1-03
+size_t UserProcess::barrierInit(size_t count)
+{
+  ScopeLock lock(barriers_lock_);
+  for (size_t i = 0; i < MAX_BARRIERS; ++i)
+  {
+    if (barriers_[i].used)
+      continue;
+    barriers_[i].used = true;
+    barriers_[i].count = count;
+    barriers_[i].waiting = 0;
+    barriers_[i].generation = 0;
+    return i + 1;                                   // 0 is never a valid id
+  }
+  return (size_t) -1;
+}
+
+size_t UserProcess::barrierWait(size_t id)
+{
+  ScopeLock lock(barriers_lock_);
+  if (id == 0 || id > MAX_BARRIERS || !barriers_[id - 1].used)
+    return (size_t) -1;
+  Barrier& barrier = barriers_[id - 1];
+  size_t my_generation = barrier.generation;
+  if (++barrier.waiting == barrier.count)
+  {
+    barrier.waiting = 0;                            // reset for the next round ...
+    ++barrier.generation;                           // ... and open the current one
+    barrier_opened_.broadcast();                    // ALL waiters, not just one
+    return 1;                                       // the "serial" thread
+  }
+  // wait for "my round has opened" - not for waiting == 0: the next round may already
+  // be filling up again when we wake up
+  while (barrier.generation == my_generation)
+    barrier_opened_.wait();
+  return 0;
+}
+
+size_t UserProcess::barrierDestroy(size_t id)
+{
+  ScopeLock lock(barriers_lock_);
+  if (id == 0 || id > MAX_BARRIERS || !barriers_[id - 1].used || barriers_[id - 1].waiting > 0)
+    return (size_t) -1;
+  barriers_[id - 1].used = false;
+  return 0;
+}
