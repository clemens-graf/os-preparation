 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -600,3 +601,47 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+size_t UserProcess::barrierInit(size_t count)
+{
+  ScopeLock lock(thread_lock_);
+  for (size_t i = 0; i < 16; ++i)
+  {
+    if (barriers_[i].count != 0)
+      continue;
+    barriers_[i].count = count;
+    barriers_[i].waiting = 0;
+    barriers_[i].round = 0;
+    return i + 1;
+  }
+  return (size_t) -1;
+}
+
+size_t UserProcess::barrierWait(size_t id)
+{
+  ScopeLock lock(thread_lock_);
+  if (id == 0 || id > 16 || barriers_[id - 1].count == 0)
+    return (size_t) -1;
+  Barrier& barrier = barriers_[id - 1];
+  size_t my_round = barrier.round;
+  barrier.waiting++;
+  if (barrier.waiting == barrier.count)        // the last one opens it for everybody
+  {
+    barrier.waiting = 0;
+    barrier.round++;
+    barrier_opened_.broadcast();
+    return 1;                                  // PTHREAD_BARRIER_SERIAL_THREAD
+  }
+  while (barrier.round == my_round)            // while, not if: a wake-up is no proof
+    barrier_opened_.wait();
+  return 0;
+}
+
+size_t UserProcess::barrierDestroy(size_t id)
+{
+  ScopeLock lock(thread_lock_);
+  if (id == 0 || id > 16 || barriers_[id - 1].count == 0 || barriers_[id - 1].waiting > 0)
+    return (size_t) -1;
+  barriers_[id - 1].count = 0;
+  return 0;
+}
