   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -600,3 +601,31 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+size_t UserProcess::sbrk(ssize_t increment)
+{
+  ScopeLock lock(thread_lock_);
+  size_t old_brk = brk_;
+  size_t new_brk = old_brk + increment;
+  if (new_brk < BRK_START || new_brk > BRK_START + BRK_MAX)
+    return (size_t) -1;
+  size_t first_vpn = (new_brk + PAGE_SIZE - 1) / PAGE_SIZE;   // shrinking: pages completely above the new break
+  size_t end_vpn = (old_brk + PAGE_SIZE - 1) / PAGE_SIZE;     // (growing: first >= end, nothing to do)
+  for (size_t vpn = first_vpn; vpn < end_vpn; vpn++)
+    if (arch_memory_->resolveMapping(vpn).page_size != 0)
+      arch_memory_->unmapPage(vpn);
+  ArchMemory::flushTlb();
+  brk_ = new_brk;
+  return old_brk;
+}
+
+bool UserProcess::mapBrkPage(size_t vpn)
+{
+  ScopeLock lock(thread_lock_);
+  if (vpn * PAGE_SIZE >= brk_)
+    return false;
+  size_t ppn = PageManager::instance()->allocPPN();
+  if (!arch_memory_->mapPage(vpn, ppn, 1))
+    PageManager::instance()->freePPN(ppn);      // another thread was faster
+  return true;
+}
