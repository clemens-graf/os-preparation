+bool Loader::mapBrkPage(size_t vpn)
+{
+  size_t ppn = PageManager::instance()->allocPPN();
+  arch_memory_lock_.acquire();
+  bool below = vpn * PAGE_SIZE < brk_;                  // check and map in one critical section
+  bool mapped = below && arch_memory_.mapPage(vpn, ppn, 1);
+  arch_memory_lock_.release();
+  if (!mapped)
+    PageManager::instance()->freePPN(ppn);
+  return below;
+}
