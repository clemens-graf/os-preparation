--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -10,6 +10,7 @@
 #include "Scheduler.h"
 #include "UserThread.h"
 #include "Mutex.h"
+#include "ScopeLock.h"
 #include "ArchMemory.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
@@ -550,3 +551,39 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A1-12
+bool UserProcess::mapBrkPage(size_t vpn)
+{
+  size_t ppn = PageManager::instance()->allocPPN();     // before the lock: keeps it short
+  thread_lock_.acquire();
+  bool below = vpn * PAGE_SIZE < brk_;                  // check and map in ONE critical section:
+  bool mapped = below && arch_memory_->mapPage(vpn, ppn, 1);   // sbrk() may shrink in between otherwise
+  thread_lock_.release();
+  if (!mapped)
+    PageManager::instance()->freePPN(ppn);              // above the break, or another thread was faster
+  return below;
+}
+
+size_t UserProcess::sbrk(ssize_t increment)
+{
+  ScopeLock lock(thread_lock_);
+  size_t old_brk = brk_;
+  size_t new_brk = old_brk + increment;
+  if (new_brk < BRK_START || new_brk > BRK_START + BRK_MAX)   // also catches wrap-around
+    return (size_t) -1;
+  if (increment < 0)
+  {
+    // shrinking: every page that now lies completely above the break goes away
+    size_t first_vpn = (new_brk + PAGE_SIZE - 1) / PAGE_SIZE;
+    size_t end_vpn = (old_brk + PAGE_SIZE - 1) / PAGE_SIZE;
+    for (size_t vpn = first_vpn; vpn < end_vpn; ++vpn)
+    {
+      if (arch_memory_->resolveMapping(vpn).page_size != 0)
+        arch_memory_->unmapPage(vpn);
+    }
+    ArchMemory::flushTlb();
+  }
+  brk_ = new_brk;            // growing: nothing to map, the page fault handler does it
+  return old_brk;
+}
