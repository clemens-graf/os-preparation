+// A1-12: move the program break by increment bytes, return the OLD break
+size_t Syscall::sbrk(ssize_t increment)
+{
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);
+  size_t old_brk = loader->brk_;
+  size_t new_brk = old_brk + increment;
+  if (new_brk < BRK_START || new_brk > BRK_START + BRK_MAX)   // also catches wrap-around
+    return (size_t) -1;
+
+  if (increment < 0)
+  {
+    // shrinking: every page that now lies completely above the break goes away
+    size_t first_vpn = (new_brk + PAGE_SIZE - 1) / PAGE_SIZE;
+    size_t end_vpn = (old_brk + PAGE_SIZE - 1) / PAGE_SIZE;
+    for (size_t vpn = first_vpn; vpn < end_vpn; ++vpn)
+    {
+      if (loader->arch_memory_.resolveMapping(vpn).page_size != 0)
+        loader->arch_memory_.unmapPage(vpn);
+    }
+    ArchMemory::flushTlb();
+  }
+  loader->brk_ = new_brk;            // growing: nothing to map, the page fault handler does it
+  return old_brk;
+}
