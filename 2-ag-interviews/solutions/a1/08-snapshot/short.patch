@@ -40,6 +40,9 @@ extern int pthread_join(pthread_t thread, void **value_ptr);
 
 extern int pthread_detach(pthread_t thread);
 
+extern int pthread_snapshot(void);
+extern int pthread_revive(void);
+
 extern int pthread_mutex_init(pthread_mutex_t *mutex,
                               const pthread_mutexattr_t *attr);
 
diff --git a/userspace/libc/src/pthread.c b/userspace/libc/src/pthread.c
index 75e67a42..b1b146e0 100644
--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -240,3 +240,13 @@ int pthread_setcanceltype(int type, int *oldtype)
   }
   return __syscall(sc_pthread_setcanceltype, (size_t)type, (size_t)oldtype, 0x00, 0x00, 0x00);
 }
+
+int pthread_snapshot(void)
+{
+  return __syscall(sc_snapshot, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
+
+int pthread_revive(void)
+{
+  return __syscall(sc_revive, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
