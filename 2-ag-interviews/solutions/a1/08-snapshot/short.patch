diff --git a/common/include/kernel/UserThread.h b/common/include/kernel/UserThread.h
index 14e8bd79..75b84bc4 100644
--- a/common/include/kernel/UserThread.h
+++ b/common/include/kernel/UserThread.h
@@ -9,6 +9,12 @@ class UserProcess;
 class UserThread : public Thread
 {
 public:
+  // A1-08: the snapshot - registers rip ... r15 (the first 19 words of ArchThreadRegisters) + used stack
+  size_t snap_regs_[19];
+  char snap_stack_[4 * 4096];
+  size_t snap_stack_size_ = 0;
+  bool has_snapshot_ = false;
+
   UserThread() = delete;
 
   UserThread(UserProcess* process, ustl::string name, uint32 terminal_number,
diff --git a/common/include/kernel/syscall-definitions.h b/common/include/kernel/syscall-definitions.h
index 290b5459..3f0935bd 100644
--- a/common/include/kernel/syscall-definitions.h
+++ b/common/include/kernel/syscall-definitions.h
@@ -44,6 +44,8 @@
 #define sc_pthread_detach 1504
 #define sc_pthread_setcancelstate 1505
 #define sc_pthread_setcanceltype 1506
+#define sc_snapshot 1660
+#define sc_revive 1661
 #define sc_thread_count 1998
 #define sc_process_count 1999
 #define PTHREAD_CANCELED ((void*) -1)
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..07aeba52 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,8 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "kstring.h"
+#include "ArchThreads.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +116,35 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_snapshot:
+    {
+      UserThread* thread = (UserThread*) currentThread;
+      size_t rsp = thread->user_registers_->rsp;
+      size_t size = (size_t) thread->getUserStackTop() - rsp;      // the used part of the stack
+      if (size > sizeof(thread->snap_stack_))
+      {
+        return_value = -1;
+        break;
+      }
+      memcpy(thread->snap_regs_, thread->user_registers_, sizeof(thread->snap_regs_));
+      memcpy(thread->snap_stack_, (void*) rsp, size);
+      thread->snap_stack_size_ = size;
+      thread->has_snapshot_ = true;
+      break;                                                       // returns 0: "taken"
+    }
+    case sc_revive:
+    {
+      UserThread* thread = (UserThread*) currentThread;
+      if (!thread->has_snapshot_)
+      {
+        return_value = -1;
+        break;
+      }
+      memcpy(thread->user_registers_, thread->snap_regs_, sizeof(thread->snap_regs_));
+      memcpy((void*) thread->user_registers_->rsp, thread->snap_stack_, thread->snap_stack_size_);
+      return_value = 1;                                            // lands in rax: snapshot() returns 1
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
diff --git a/userspace/libc/include/pthread.h b/userspace/libc/include/pthread.h
