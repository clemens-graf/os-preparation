--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -231,3 +231,13 @@ int pthread_setcanceltype(int type, int *oldtype)
 {
   return -1;
 }
+
+int pthread_snapshot(void)
+{
+  return __syscall(sc_snapshot, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
+
+int pthread_revive(void)
+{
+  return __syscall(sc_revive, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
