+// A1-08: save registers + the used part of the user stack of the calling thread
+size_t Syscall::snapshot()
+{
+  UserThread* thread = (UserThread*) currentThread;
+  ArchThreadRegisters* regs = thread->user_registers_;
+  size_t stack_size = (size_t) thread->getUserStackTop() - regs->rsp;   // this thread's own stack slot
+  if (stack_size > SNAPSHOT_MAX_STACK)
+    return (size_t) -1;
+
+  if (!thread->snapshot_)
+    thread->snapshot_ = new ThreadSnapshot;
+  ThreadSnapshot* s = thread->snapshot_;
+
+  // field by field: copying the ArchThreadRegisters struct would also copy its fpu pointer
+  // (and its destructor would free the fpu buffer of the thread)
+  s->rip = regs->rip;
+  s->rflags = regs->rflags;
+  s->rax = regs->rax;
+  s->rbx = regs->rbx;
+  s->rcx = regs->rcx;
+  s->rdx = regs->rdx;
+  s->rsi = regs->rsi;
+  s->rdi = regs->rdi;
+  s->rbp = regs->rbp;
+  s->rsp = regs->rsp;
+  s->r8 = regs->r8;
+  s->r9 = regs->r9;
+  s->r10 = regs->r10;
+  s->r11 = regs->r11;
+  s->r12 = regs->r12;
+  s->r13 = regs->r13;
+  s->r14 = regs->r14;
+  s->r15 = regs->r15;
+
+  // the stack belongs to the state: without it, revive would continue with frames that have
+  // been overwritten since (the __syscall frame of pthread_revive lies exactly where the one of
+  // pthread_snapshot was)
+  s->stack_size = stack_size;
+  memcpy(s->stack, (void*) regs->rsp, stack_size);
+  return 0;                                    // "taken"
+}
+
+// A1-08: back to the snapshot - pthread_snapshot() returns a second time, with 1
+size_t Syscall::revive()
+{
+  UserThread* thread = (UserThread*) currentThread;
+  ThreadSnapshot* s = thread->snapshot_;
+  if (!s)
+    return (size_t) -1;
+
+  ArchThreadRegisters* regs = thread->user_registers_;
+  memcpy((void*) s->rsp, s->stack, s->stack_size);   // these pages were mapped then and still are
+  regs->rip = s->rip;
+  regs->rflags = s->rflags;
+  regs->rax = s->rax;
+  regs->rbx = s->rbx;
+  regs->rcx = s->rcx;
+  regs->rdx = s->rdx;
+  regs->rsi = s->rsi;
+  regs->rdi = s->rdi;
+  regs->rbp = s->rbp;
+  regs->rsp = s->rsp;
+  regs->r8 = s->r8;
+  regs->r9 = s->r9;
+  regs->r10 = s->r10;
+  regs->r11 = s->r11;
+  regs->r12 = s->r12;
+  regs->r13 = s->r13;
+  regs->r14 = s->r14;
+  regs->r15 = s->r15;
+  return 1;    // written into rax: the old pthread_snapshot() call now returns 1
+}
