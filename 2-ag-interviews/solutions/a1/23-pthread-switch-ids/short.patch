diff --git a/common/include/kernel/syscall-definitions.h b/common/include/kernel/syscall-definitions.h
index db84270e..e49ec72c 100644
--- a/common/include/kernel/syscall-definitions.h
+++ b/common/include/kernel/syscall-definitions.h
@@ -34,6 +34,7 @@
 #define sc_pthread_cancel 1502
 #define sc_pthread_testcancel 1503
 #define sc_pthread_detach 1504
+#define sc_pthread_switch 1730
 #define sc_thread_count 1998
 #define sc_process_count 1999
 
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 178fc3a2..987e5246 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,7 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -89,6 +90,25 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_switch:
+    {
+      UserProcess* process = currentThread->getProcess();
+      ScopeLock lock(process->getThreadLock());
+      UserThreadData* a = process->findThreadDataByTid(arg1);
+      UserThreadData* b = process->findThreadDataByTid(arg2);
+      if (arg1 == arg2 || !a || !b || a->joined_ || b->joined_)
+      {
+        return_value = -1;
+        break;
+      }
+      a->tid_ = arg2;                          // the records swap their ids ...
+      b->tid_ = arg1;
+      if (a->thread_)                          // ... and so do the running threads
+        a->thread_->setTID(arg2);
+      if (b->thread_)
+        b->thread_->setTID(arg1);
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
