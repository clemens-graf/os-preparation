+// A1-23: the two threads exchange their ids
+size_t Syscall::pthreadSwitch(size_t thread_a, size_t thread_b)
+{
+  UserProcess* process = currentThread->getProcess();
+  if (!process)
+    return (size_t) -1;
+  return process->switchThreadIds(thread_a, thread_b);
+}
