+
+// A1-19: wait for a child process, store its exit code in *status
+size_t Syscall::waitpid(size_t pid, size_t status)
+{
+  if (status != 0 && status > USER_BREAK - sizeof(int))
+    return (size_t) -1;
+  size_t exit_code = 0;
+  if (ProcessRegistry::instance()->waitForChild(currentThread->getProcess()->getPID(), pid, &exit_code) != 0)
+    return (size_t) -1;
+  if (status)
+    *(int*) status = (int) exit_code;        // user memory only after the lock is released
+  return pid;
+}
