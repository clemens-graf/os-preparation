+
+// A1-19
+void ProcessRegistry::processCreated(size_t pid, size_t ppid)
+{
+  ScopeLock lock(records_lock_);
+  for (ProcessRecord& record : records_)
+  {
+    if (!record.used)
+    {
+      record = {true, false, pid, ppid, 0};
+      return;
+    }
+  }
+  debug(PROCESS_REG, "no free process record for pid %zu - waitpid will not find it\n", pid);
+}
+
+void ProcessRegistry::processFinished(size_t pid, size_t exit_code)
+{
+  ScopeLock lock(records_lock_);
+  for (ProcessRecord& record : records_)
+  {
+    if (record.used && record.ppid == pid)
+      record.used = false;                 // its children: nobody can wait for them any more
+  }
+  for (ProcessRecord& record : records_)
+  {
+    if (record.used && record.pid == pid)
+    {
+      record.finished = true;
+      record.exit_code = exit_code;
+      if (record.ppid == 0)
+        record.used = false;               // started by the kernel: nobody will wait
+    }
+  }
+  process_finished_.broadcast();           // every waitpid re-checks its own child
+}
+
+size_t ProcessRegistry::waitForChild(size_t ppid, size_t pid, size_t* exit_code)
+{
+  ScopeLock lock(records_lock_);
+  while (true)
+  {
+    ProcessRecord* child = nullptr;
+    for (ProcessRecord& record : records_)
+    {
+      if (record.used && record.pid == pid && record.ppid == ppid)
+        child = &record;
+    }
+    if (!child)
+      return (size_t) -1;                  // unknown, not ours, or already waited for
+    if (child->finished)
+    {
+      *exit_code = child->exit_code;
+      child->used = false;                 // reaped: a second waitpid fails
+      return 0;
+    }
+    process_finished_.wait();
+  }
+}
