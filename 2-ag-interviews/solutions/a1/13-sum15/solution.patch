 }
 
+
+// A1-13: 15 arguments: 4 in registers, the other 11 in an array in user memory.
+// Returns 1*a1 + 2*a2 + ... + 15*a15 - the weights make a wrong order visible.
+size_t Syscall::sum15(size_t a1, size_t a2, size_t a3, size_t a4, size_t rest)
+{
+  const size_t REST = 11;
+  if (rest == 0 || rest >= USER_BREAK - REST * sizeof(size_t))
+    return (size_t) -1;
+  size_t args[15] = {a1, a2, a3, a4};
+  memcpy(&args[4], (void*) rest, REST * sizeof(size_t));   // copy in once, then use only the copy
+  size_t sum = 0;
+  for (size_t i = 0; i < 15; ++i)
+    sum += (i + 1) * args[i];
+  return sum;
+}
