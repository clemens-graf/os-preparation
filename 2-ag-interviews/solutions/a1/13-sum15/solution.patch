\ No newline at end of file
+}
+
+// A1-13
+size_t sum15(size_t a1, size_t a2, size_t a3, size_t a4, size_t a5, size_t a6, size_t a7, size_t a8,
+             size_t a9, size_t a10, size_t a11, size_t a12, size_t a13, size_t a14, size_t a15)
+{
+  // __syscall carries 5 values: 4 arguments + the address of the other 11 on our stack
+  size_t rest[11] = {a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15};
+  return __syscall(sc_sum15, a1, a2, a3, a4, (size_t) rest);
+}
