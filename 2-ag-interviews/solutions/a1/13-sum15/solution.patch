diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..ed958dcd 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,7 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "kstring.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +115,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_sum15:
+      return_value = sum15(arg1, arg2, arg3, arg4, arg5);
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -864,3 +868,18 @@ size_t Syscall::pthreadSetCancelType(int new_type, int *oldtype)
   }
   return 0;
 }
+
+// A1-13: 15 arguments: 4 in registers, the other 11 in an array in user memory.
+// Returns 1*a1 + 2*a2 + ... + 15*a15 - the weights make a wrong order visible.
+size_t Syscall::sum15(size_t a1, size_t a2, size_t a3, size_t a4, size_t rest)
+{
+  const size_t REST = 11;
+  if (rest == 0 || rest > USER_BREAK - REST * sizeof(size_t))
+    return (size_t) -1;
+  size_t args[15] = {a1, a2, a3, a4};
+  memcpy(&args[4], (void*) rest, REST * sizeof(size_t));   // copy in once, then use only the copy
+  size_t sum = 0;
+  for (size_t i = 0; i < 15; ++i)
+    sum += (i + 1) * args[i];
+  return sum;
+}
