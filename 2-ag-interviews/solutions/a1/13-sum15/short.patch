diff --git a/userspace/libc/src/nonstd.c b/userspace/libc/src/nonstd.c
index 4c40ec43..3902dc4f 100644
--- a/userspace/libc/src/nonstd.c
+++ b/userspace/libc/src/nonstd.c
@@ -29,3 +29,10 @@ unsigned long getUsedKernelMemory(void)
 {
   return __syscall(sc_get_used_kernel_memory, 0x00, 0x00, 0x00, 0x00, 0x00);
 }
+
+size_t sum15(size_t a1, size_t a2, size_t a3, size_t a4, size_t a5, size_t a6, size_t a7, size_t a8,
+             size_t a9, size_t a10, size_t a11, size_t a12, size_t a13, size_t a14, size_t a15)
+{
+  size_t rest[11] = {a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15};   // 4 registers + 1 pointer
+  return __syscall(sc_sum15, a1, a2, a3, a4, (size_t) rest);
+}
