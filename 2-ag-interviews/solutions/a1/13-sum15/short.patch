 #ifdef __cplusplus
@@ -31,6 +32,9 @@ extern int getProcessCount(void);
  */
 extern unsigned long getUsedKernelMemory(void);
 
+extern size_t sum15(size_t a1, size_t a2, size_t a3, size_t a4, size_t a5, size_t a6, size_t a7, size_t a8,
+                    size_t a9, size_t a10, size_t a11, size_t a12, size_t a13, size_t a14, size_t a15);
