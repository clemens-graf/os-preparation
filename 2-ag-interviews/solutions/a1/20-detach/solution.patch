+size_t UserProcess::detachThread(size_t tid)
+{
+  ScopeLock lock(thread_lock_);
+  UserThreadData* thread_data = findThreadDataByTid(tid);
+  if (!thread_data || thread_data->detached_ || thread_data->joined_)
+    return (size_t) -1;
+  if (thread_data->exited_)
+  {
+    removeThreadDataFromList(thread_data);   // already ended: its record is all that is left
