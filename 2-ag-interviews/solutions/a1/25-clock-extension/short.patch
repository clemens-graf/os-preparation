diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 9ff25399..8c3eae6e 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,7 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "ScopeLock.h"
 #include "Clock.h"
 
 #define PTHREAD_CREATE_ERROR -1
@@ -114,6 +115,22 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_clock_get_res:
       return_value = clockGetRes((clockid_t)arg1, (struct timespec*)arg2);
       break;
+    case sc_thread_cputime:
+    {
+      UserProcess* process = currentThread->getProcess();
+      ScopeLock lock(process->getThreadLock());
+      UserThreadData* data = process->findThreadDataByTid(arg1);
+      if (!data || !data->thread_)
+        return_value = -1;
+      else if (data->thread_ == currentThread)
+        return_value = Clock::instance()->getThreadTime(currentThread);    // + the running slice
+      else
+        return_value = Clock::instance()->cyclesToNanoseconds(data->thread_->getCpuCycles());   // not running: only its counted cycles
+      break;
+    }
+    case sc_timer_irq_time:
+      return_value = Clock::instance()->cyclesToNanoseconds(Clock::instance()->timer_irq_cycles_);
+      break;
     case sc_clock_get_time:
       return_value = clockGetTime((clockid_t)arg1, (struct timespec*)arg2);
       break;
