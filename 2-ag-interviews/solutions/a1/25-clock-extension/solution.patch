@@ -11,6 +11,7 @@
 #include "UserThread.h"
 #include "Mutex.h"
 #include "ArchMemory.h"
+#include "Clock.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, size_t ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -708,3 +709,17 @@ void UserProcess::addCpuCycles(uint64 cycles)
 {
   cpu_cycles_ += cycles;
 }
+
+// A1-25
+size_t UserProcess::threadCpuTime(size_t tid)
+{
+  ScopeLock lock(thread_lock_);
+  UserThreadData* data = findThreadDataByTid(tid);
+  if (!data || !data->thread_)
+    return (size_t) -1;                       // unknown, or already ended
+  if (data->thread_ == currentThread)
+    return Clock::instance()->getThreadTime(currentThread);   // + the part of the running time slice
+  // another thread is not running right now: only its counted cycles - getThreadTime() would
+  // add the time since the CURRENT thread's slice began, which is not this thread's time
+  return Clock::instance()->cyclesToNanoseconds(data->thread_->getCpuCycles());
+}
