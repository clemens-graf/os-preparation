+// A1-21
+size_t UserProcess::forkall(UserThread* caller)
+{
+  int child_fd = -1;
+  Loader* child_loader = loadExecutable(filename_.c_str(), child_fd);   // disk i/o: before taking the lock
+  if (!child_loader)
+    return (size_t) -1;
+
+  ustl::vector<UserThread*> copies;
+  UserThread* caller_copy = nullptr;
+  UserProcess* child = nullptr;
+  {
+    // the thread list, the stack slots and the page tables must not change while we copy them
+    ScopeLock lock(thread_lock_);
+
+    child = new UserProcess(filename_, new FileSystemInfo(*working_dir_), terminal_number_,
+                            child_loader, child_fd, getPID(), new ArchMemory(*arch_memory_));
+    child->next_stack_slot_ = next_stack_slot_;      // the copied stacks keep their slots
+
+    for (size_t i = 0; i < threads_.size(); i++)
+    {
+      UserThreadData* data = threads_[i];
+      if (!data)
+        continue;
+      UserThreadData* data_copy = new UserThreadData(*data);   // tid, exit value, exited, detached, ...
+      data_copy->joined_ = false;                              // nobody in the child is joining yet
+      UserThread* original = data->thread_;
+      if (original)                                            // still running: copy the thread too
+      {
+        UserThread* copy = new UserThread(child, original);    // registers copied, rax = 0
+        copy->setTID(data->tid_);                              // same tid: pthread_t values in memory stay valid
+        copy->setUserStackTop(original->getUserStackTop());
+        copy->setUserStackLowestMappedVpn(original->getUserStackLowestMappedVpn());
+        if (original != caller)
+          copy->user_registers_->rax = original->in_syscall_ ? (size_t) -1    // its syscall "fails" in the child
+                                                              : original->user_registers_->rax;
+        copy->setRegisteredInProcess(true);
+        child->running_threads_++;
+        data_copy->thread_ = copy;
+        if (original == caller)
+          caller_copy = copy;
+        else
+          copies.push_back(copy);
+      }
+      child->threads_.push_back(data_copy);
+    }
+  }
+  assert(caller_copy && "the caller must be in its own thread list");
+
+  // hold the child's lock until every thread is known to the scheduler: if a copy calls exit()
+  // at once, exitProcess must not find threads that the scheduler does not know yet
+  ScopeLock child_lock(child->thread_lock_);
+  size_t child_pid = child->getPID();
+  child->startProcess(caller_copy);
+  for (size_t i = 0; i < copies.size(); i++)
+    Scheduler::instance()->addNewThread(copies[i]);
+  return child_pid;
+}
