+
+size_t UserProcess::forkall(UserThread* caller)
+{
+  int fd = -1;
+  Loader* loader = loadExecutable(filename_.c_str(), fd);     // disk i/o: before the lock
+  if (!loader)
+    return (size_t) -1;
+  UserProcess* child = nullptr;
+  UserThread* caller_copy = nullptr;
+  ustl::vector<UserThread*> others;
+  {
+    ScopeLock lock(thread_lock_);
+    child = new UserProcess(filename_, new FileSystemInfo(*working_dir_), terminal_number_,
+                            loader, fd, getPID(), new ArchMemory(*arch_memory_));
+    child->next_stack_slot_ = next_stack_slot_;
+    for (size_t i = 0; i < threads_.size(); i++)
+    {
+      UserThreadData* data = new UserThreadData(*threads_[i]);   // tid, exit value, exited, detached
+      data->joined_ = false;
+      UserThread* original = threads_[i]->thread_;
+      if (original)                                              // still running: copy the thread too
+      {
+        UserThread* copy = new UserThread(child, original);      // registers copied, rax = 0
+        copy->setTID(original->getTID());                        // same ids: pthread_t values stay valid
+        copy->setUserStackTop(original->getUserStackTop());
+        copy->setUserStackLowestMappedVpn(original->getUserStackLowestMappedVpn());
+        if (original != caller)                                  // inside the kernel: its syscall fails in the child
+          copy->user_registers_->rax = original->switch_to_userspace_ ? original->user_registers_->rax : (size_t) -1;
+        copy->setRegisteredInProcess(true);
+        child->running_threads_++;
+        data->thread_ = copy;
+        if (original == caller)
+          caller_copy = copy;
+        else
+          others.push_back(copy);
+      }
+      child->threads_.push_back(data);
+    }
+  }
+  ScopeLock child_lock(child->thread_lock_);
+  size_t pid = child->getPID();
+  child->startProcess(caller_copy);
+  for (size_t i = 0; i < others.size(); i++)
+    Scheduler::instance()->addNewThread(others[i]);
+  return pid;
+}
