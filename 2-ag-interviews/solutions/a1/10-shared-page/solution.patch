index e32f2cda..1d1117ec 100644
--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -10,7 +10,9 @@
 #include "Scheduler.h"
 #include "UserThread.h"
 #include "Mutex.h"
+#include "ScopeLock.h"
 #include "ArchMemory.h"
+#include "SharedPages.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -31,6 +33,16 @@ UserProcess::~UserProcess()
 
   delete working_dir_;
   delete loader_;
+  // A1-10: unmap the shared pages WITHOUT freeing them - ~ArchMemory would free every present
+  // page, also the ones other processes still use
+  for (size_t key = 1; key < SHM_MAX_KEYS; ++key)
+  {
+    if (shm_attached_ & (1UL << key))
+    {
+      arch_memory_->unmapPage(SHM_BASE / PAGE_SIZE + key, false);
+      SharedPages::instance()->release(key);
+    }
+  }
   delete arch_memory_;
 
   debug(USERPROCESS, "signaling ProcessRegistry the deletion for process with ppid: %zu, pid: %zu filename: %s, file descriptor: %d\n", ppid_, pid_, filename_.c_str(), fd_);
@@ -600,3 +612,45 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A1-10
+size_t UserProcess::shmAttach(size_t key)
+{
+  if (key == 0 || key >= SHM_MAX_KEYS)
+    return 0;
+  size_t vpn = SHM_BASE / PAGE_SIZE + key;
+
+  // 1. reserve a reference first: from now on the page cannot be freed under us
+  size_t ppn = SharedPages::instance()->acquire(key);
+  // 2. then map it under the page-table lock - never holding both locks at once
+  bool already;
+  {
+    ScopeLock lock(thread_lock_);
+    already = shm_attached_ & (1UL << key);
+    if (!already)
+    {
+      bool mapped = arch_memory_->mapPage(vpn, ppn, 1);
+      assert(mapped && "the shm region is only mapped by shmAttach");
+      shm_attached_ |= 1UL << key;
+    }
+  }
+  if (already)
+    SharedPages::instance()->release(key);   // attached twice: keep only one reference
+  return vpn * PAGE_SIZE;
+}
+
+size_t UserProcess::shmDetach(size_t key)
+{
+  if (key == 0 || key >= SHM_MAX_KEYS)
+    return (size_t) -1;
+  {
+    ScopeLock lock(thread_lock_);
+    if (!(shm_attached_ & (1UL << key)))
+      return (size_t) -1;
+    arch_memory_->unmapPage(SHM_BASE / PAGE_SIZE + key, false);   // NOT freed: others may use it
+    ArchMemory::flushTlb();
+    shm_attached_ &= ~(1UL << key);
+  }
+  SharedPages::instance()->release(key);     // ... unless we were the last one
+  return 0;
+}
