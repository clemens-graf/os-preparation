diff --git a/common/include/mm/SharedPages.h b/common/include/mm/SharedPages.h
new file mode 100644
index 00000000..44216332
--- /dev/null
+++ b/common/include/mm/SharedPages.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "types.h"
+
+class Mutex;
+
+#define SHM_MAX_KEYS 16
+#define SHM_BASE 0x0000400000000000ULL   // key k is mapped at SHM_BASE + k * PAGE_SIZE
+
+/**
+ * A1-10: physical pages shared between processes, identified by a key (1 .. SHM_MAX_KEYS-1).
+ * A page lives as long as at least one process has it attached (reference count).
+ */
+class SharedPages
+{
+  public:
+    static SharedPages* instance();
+    static void init();                        // from startup(): no global constructors in SWEB
+
+    /** reference +1 (creates the page if needed) @return its ppn */
+    size_t acquire(size_t key);
+    /** reference -1, frees the page when the last reference is gone */
+    void release(size_t key);
+
+  private:
+    SharedPages();
+    static SharedPages* instance_;
+
+    struct Entry
+    {
+      size_t ppn;        // 0 = no page for this key
+      size_t references;
+    };
+    Mutex* lock_;        // protects entries_
+    Entry entries_[SHM_MAX_KEYS];
+};
