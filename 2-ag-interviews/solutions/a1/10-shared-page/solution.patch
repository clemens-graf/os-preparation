+
+// A1-10: map shared page key into the calling process
+size_t Syscall::shmAttach(size_t key)
+{
+  if (key == 0 || key >= SHM_MAX_KEYS)
+    return 0;
+  Loader* loader = currentThread->loader_;
+  size_t vpn = SHM_BASE / PAGE_SIZE + key;
+
+  // 1. reserve a reference first: from now on the page cannot be freed under us
+  size_t ppn = SharedPages::instance()->acquire(key);
+  // 2. then map it - never holding both locks at once
+  loader->arch_memory_lock_.acquire();
+  bool already = loader->shm_attached_ & (1UL << key);
+  if (!already)
+  {
+    bool mapped = loader->arch_memory_.mapPage(vpn, ppn, 1);
+    assert(mapped && "the shm region is only mapped by shmAttach");
+    loader->shm_attached_ |= 1UL << key;
+  }
+  loader->arch_memory_lock_.release();
+  if (already)
+    SharedPages::instance()->release(key);   // attached twice: keep only one reference
+  return vpn * PAGE_SIZE;
+}
+
+size_t Syscall::shmDetach(size_t key)
+{
+  if (key == 0 || key >= SHM_MAX_KEYS)
+    return (size_t) -1;
+  Loader* loader = currentThread->loader_;
+  loader->arch_memory_lock_.acquire();
+  if (!(loader->shm_attached_ & (1UL << key)))
+  {
+    loader->arch_memory_lock_.release();
+    return (size_t) -1;
+  }
+  loader->arch_memory_.unmapPage(SHM_BASE / PAGE_SIZE + key, false);   // NOT freed: others may use it
+  ArchMemory::flushTlb();
+  loader->shm_attached_ &= ~(1UL << key);
+  loader->arch_memory_lock_.release();
+  SharedPages::instance()->release(key);     // ... unless we were the last one
+  return 0;
+}
