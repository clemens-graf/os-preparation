diff --git a/common/source/kernel/UserProcess.cpp b/common/source/kernel/UserProcess.cpp
index 2973d144..76d9cfb8 100644
--- a/common/source/kernel/UserProcess.cpp
+++ b/common/source/kernel/UserProcess.cpp
@@ -13,6 +13,11 @@
 #include "UserThread.h"
 #include "Mutex.h"
 #include "ArchMemory.h"
+#include "ScopeLock.h"
+
+size_t shm_ppn[SHM_KEYS] = {};
+size_t shm_refs[SHM_KEYS] = {};
+Mutex* shm_lock = nullptr;
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, size_t ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -45,6 +50,18 @@ UserProcess::~UserProcess()
 
   delete working_dir_;
   delete loader_;
+  {
+    ScopeLock global(*shm_lock);
+    for (size_t key = 1; key < SHM_KEYS; ++key)
+    {
+      if (!shm_attached_[key])
+        continue;
+      arch_memory_->unmapPage(SHM_BASE / PAGE_SIZE + key, false);
+      shm_refs[key]--;
+      if (shm_refs[key] == 0)
+        PageManager::instance()->freePPN(shm_ppn[key]);
+    }
+  }
   delete arch_memory_;
 
   debug(USERPROCESS, "deleted process with ppid: %zu, pid: %zu, filename: %s\n", ppid_, pid_, filename_.c_str());
@@ -936,3 +953,39 @@ void UserProcess::addCpuCycles(uint64 cycles)
 {
   cpu_cycles_ += cycles;
 }
+
+size_t UserProcess::shmAttach(size_t key)
+{
+  if (key == 0 || key >= SHM_KEYS)
+    return 0;
+  size_t vpn = SHM_BASE / PAGE_SIZE + key;
+  ScopeLock global(*shm_lock);
+  ScopeLock local(thread_lock_);
+  if (!shm_attached_[key])
+  {
+    if (shm_refs[key] == 0)
+      shm_ppn[key] = PageManager::instance()->allocPPN();
+    shm_refs[key]++;
+    bool mapped = arch_memory_->mapPage(vpn, shm_ppn[key], 1);
+    assert(mapped);
+    shm_attached_[key] = true;
+  }
+  return vpn * PAGE_SIZE;
+}
+
+size_t UserProcess::shmDetach(size_t key)
+{
+  if (key == 0 || key >= SHM_KEYS)
+    return (size_t) -1;
+  ScopeLock global(*shm_lock);
+  ScopeLock local(thread_lock_);
+  if (!shm_attached_[key])
+    return (size_t) -1;
+  arch_memory_->unmapPage(SHM_BASE / PAGE_SIZE + key, false);
+  ArchMemory::flushTlb();
+  shm_attached_[key] = false;
+  shm_refs[key]--;
+  if (shm_refs[key] == 0)
+    PageManager::instance()->freePPN(shm_ppn[key]);
+  return 0;
+}
