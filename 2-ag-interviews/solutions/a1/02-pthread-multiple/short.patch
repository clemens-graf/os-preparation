+size_t UserProcess::createMultiple(size_t* ids, size_t count, void* entry, void* start_routine, void** args)
+{
+  if (count == 0 || count > 64)
+    return (size_t) -1;
+  UserThread* created[64];
+  for (size_t i = 0; i < count; ++i)
+  {
+    created[i] = createThread(entry, true, start_routine, args ? args[i] : 0);
+    if (created[i])
+      continue;
+    for (size_t j = 0; j < i; ++j)            // all or nothing: undo the ones created so far
+    {
+      {
+        ScopeLock lock(thread_lock_);
+        UserThreadData* data = findThreadData(created[j]);
+        freeUserThreadStack(data);
+        removeThreadDataFromList(data);
+        delete data;
+        running_threads_--;
+      }
+      created[j]->setRegisteredInProcess(false);
+      delete created[j];                      // never scheduled: safe to delete directly
+    }
+    return (size_t) -1;
+  }
+  for (size_t i = 0; i < count; ++i)
+    ids[i] = created[i]->getTID();
+  for (size_t i = 0; i < count; ++i)
+    Scheduler::instance()->addNewThread(created[i]);   // only now they can run
+  return 0;
+}
+
+size_t UserProcess::joinAny(size_t* tids, size_t count, size_t* index, void** value)
+{
+  ScopeLock lock(thread_lock_);
+  while (true)
+  {
+    bool any_joinable = false;
+    for (size_t i = 0; i < count; ++i)
+    {
+      UserThreadData* data = findThreadDataByTid(tids[i]);
+      if (!data || data->joined_ || tids[i] == currentThread->getTID())
+        continue;
+      if (data->exited_)
+      {
+        *index = i;
+        *value = data->exit_value_;
+        removeThreadDataFromList(data);
+        delete data;
+        return 0;
+      }
+      any_joinable = true;
+    }
+    if (!any_joinable)
+      return (size_t) -1;                     // waiting would never end
+    thread_exited_.wait();
+  }
+}
