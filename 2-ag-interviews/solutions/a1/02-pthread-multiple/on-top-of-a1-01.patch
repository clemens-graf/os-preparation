 }
+
+void UserProcess::discardThread(UserThread* thread)
+{
+  size_t slot = thread->getStackSlot();
+  delete thread;                          // unmaps its stack, marks the slot FINISHED
+  ScopeLock lock(threads_lock_);
+  slots_[slot].state = SLOT_FREE;         // nobody knows its id: nobody will join it
+}
+
+size_t UserProcess::joinAny(const size_t* ids, size_t count, size_t* index, size_t* exit_value)
+{
+  ScopeLock lock(threads_lock_);
+  while (true)
+  {
+    bool any_alive = false;
+    for (size_t i = 0; i < count; ++i)
+    {
+      for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+      {
+        if (slots_[slot].state == SLOT_FREE || slots_[slot].id != ids[i])
+          continue;
+        if (slots_[slot].state == SLOT_FINISHED)
+        {
+          *index = i;                     // found one: join it, all under the same lock
+          *exit_value = slots_[slot].exit_value;
+          slots_[slot].state = SLOT_FREE;
+          return 0;
+        }
+        any_alive = true;                 // RUNNING: worth waiting for
+      }
+    }
+    if (!any_alive)
+      return (size_t) -1;                 // nothing left to wait for - waiting would never end
+    threads_changed_.wait();              // broadcast by every threadFinished
+  }
+}
