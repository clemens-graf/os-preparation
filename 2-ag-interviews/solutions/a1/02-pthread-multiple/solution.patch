+
+UserThread* UserProcess::createThread(size_t entry, size_t start_routine, size_t argument)
+{
+  threads_lock_.acquire();
+  size_t slot = 1;
+  while (slot <= MAX_USER_THREADS && slots_[slot].state != SLOT_FREE)
+    ++slot;
+  if (slot > MAX_USER_THREADS)
+  {
+    threads_lock_.release();
+    return nullptr;
+  }
+  size_t id = next_thread_id_++;
+  slots_[slot].state = SLOT_RUNNING;
+  slots_[slot].id = id;
+  ++num_threads_;
+  threads_lock_.release();
+
+  // outside threads_lock_: the constructor takes arch_memory_lock_ and allocates
+  return new UserThread(this, slot, id, entry, start_routine, argument);
+}
+
+void UserProcess::threadFinished(size_t slot, size_t exit_value)
+{
+  threads_lock_.acquire();
+  slots_[slot].state = SLOT_FINISHED;
+  slots_[slot].exit_value = exit_value;
+  --num_threads_;
+  threads_changed_.broadcast();   // joiners of this thread AND the main thread waiting in exit
+  threads_lock_.release();
+}
+
+size_t UserProcess::joinThread(size_t id, size_t* exit_value)
+{
+  ScopeLock lock(threads_lock_);
+  size_t slot = 1;
+  while (slot <= MAX_USER_THREADS && (slots_[slot].state == SLOT_FREE || slots_[slot].id != id))
+    ++slot;
+  if (slot > MAX_USER_THREADS)
+    return (size_t) -1;                                   // no such thread, or already joined
+  if (currentThread != this && ((UserThread*) currentThread)->getThreadId() == id)
+    return (size_t) -1;                                   // joining yourself would never end
+
+  // the slot may be joined by someone else while we sleep, and then reused by a new thread:
+  // re-check that it is still OUR thread after every wake-up
+  while (slots_[slot].state == SLOT_RUNNING && slots_[slot].id == id)
+    threads_changed_.wait();
+  if (slots_[slot].state != SLOT_FINISHED || slots_[slot].id != id)
+    return (size_t) -1;                                   // another joiner was faster
+
+  *exit_value = slots_[slot].exit_value;
+  slots_[slot].state = SLOT_FREE;                         // the slot (and stack area) can be reused
+  return 0;
+}
+
+void UserProcess::waitForThreads()
+{
+  threads_lock_.acquire();
+  while (num_threads_ > 0)
+    threads_changed_.wait();
+  threads_lock_.release();
+}
+
+void UserProcess::discardThread(UserThread* thread)
+{
+  size_t slot = thread->getStackSlot();
+  delete thread;                          // unmaps its stack, marks the slot FINISHED
+  ScopeLock lock(threads_lock_);
+  slots_[slot].state = SLOT_FREE;         // nobody knows its id: nobody will join it
+}
+
+size_t UserProcess::joinAny(const size_t* ids, size_t count, size_t* index, size_t* exit_value)
+{
+  ScopeLock lock(threads_lock_);
+  while (true)
+  {
+    bool any_alive = false;
+    for (size_t i = 0; i < count; ++i)
+    {
+      for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+      {
+        if (slots_[slot].state == SLOT_FREE || slots_[slot].id != ids[i])
+          continue;
+        if (slots_[slot].state == SLOT_FINISHED)
+        {
+          *index = i;                     // found one: join it, all under the same lock
+          *exit_value = slots_[slot].exit_value;
+          slots_[slot].state = SLOT_FREE;
+          return 0;
+        }
+        any_alive = true;                 // RUNNING: worth waiting for
+      }
+    }
+    if (!any_alive)
+      return (size_t) -1;                 // nothing left to wait for - waiting would never end
+    threads_changed_.wait();              // broadcast by every threadFinished
+  }
+}
diff --git a/common/source/kernel/UserThread.cpp b/common/source/kernel/UserThread.cpp
new file mode 100644
index 0000000..eafd01c
--- /dev/null
+++ b/common/source/kernel/UserThread.cpp
@@ -0,0 +1,69 @@
+#include "UserThread.h"
+#include "UserProcess.h"
+#include "Loader.h"
+#include "ArchMemory.h"
+#include "ArchThreads.h"
+#include "PageManager.h"
+#include "kprintf.h"
+
+UserThread::UserThread(UserProcess* process, size_t stack_slot, size_t thread_id, size_t entry,
+                       size_t start_routine, size_t argument) :
+    Thread(process->getWorkingDirInfo(), process->getName(), Thread::USER_THREAD),
+    exit_value_((size_t) -1), stack_slot_(stack_slot), thread_id_(thread_id)
+{
+  process_ = process;
+  loader_ = process->loader_;                      // same loader = same address space
+
+  // 1. the stack: map the top pages of this thread's slot
+  for (size_t i = 1; i <= USER_THREAD_STACK_PAGES; ++i)
+  {
+    size_t ppn = PageManager::instance()->allocPPN();
+    loader_->arch_memory_lock_.acquire();
+    bool mapped = loader_->arch_memory_.mapPage(stackTop() / PAGE_SIZE - i, ppn, 1);
+    loader_->arch_memory_lock_.release();
+    assert(mapped && "a slot's stack is unmapped before the slot is reused");
+  }
+
+  // 2. the registers: start in the libc entry function, entry(start_routine, argument)
+  ArchThreads::createUserRegisters(user_registers_, (void*) entry, (void*) (stackTop() - sizeof(pointer)),
+                                   getKernelStackStartPointer());
+  user_registers_->rdi = start_routine;            // 1st argument
+  user_registers_->rsi = argument;                 // 2nd argument
+
+  // 3. the address space: cr3 of the process
+  ArchThreads::setAddressSpace(this, loader_->arch_memory_);
+  setTerminal(process->getTerminal());
+  debug(USERPROCESS, "UserThread %zu created, stack top %zx\n", getThreadId(), stackTop());
+}
+
+UserThread::~UserThread()
+{
+  // runs in the CleanupThread - this thread will never run again, its stack is free
+  loader_->arch_memory_lock_.acquire();
+  for (size_t i = 1; i <= USER_THREAD_STACK_PAGES; ++i)
+    loader_->arch_memory_.unmapPage(stackTop() / PAGE_SIZE - i);
+  loader_->arch_memory_lock_.release();
+
+  // last line on purpose: once the process knows we are gone, it may delete loader_
+  process_->threadFinished(stack_slot_, exit_value_);
+}
+
+void UserThread::Run()
+{
+  assert(false && "user threads do not run in kernel mode");
+}
+
+size_t UserThread::getThreadId() const
+{
+  return thread_id_;
+}
+
+size_t UserThread::getStackSlot() const
+{
+  return stack_slot_;
+}
+
+size_t UserThread::stackTop() const
+{
+  return USER_BREAK - stack_slot_ * STACK_SLOT_SIZE;
+}
