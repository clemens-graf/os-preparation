+// A1-02: count threads, all or nothing
+size_t Syscall::pthreadMultiple(size_t ids, size_t count, size_t start_routine, size_t args, size_t entry)
+{
+  size_t bytes = count * sizeof(size_t);
+  if (count == 0 || count > MAX_USER_THREADS)
+    return (size_t) -1;
+  if (ids == 0 || ids > USER_BREAK - bytes)
+    return (size_t) -1;
+  if (args != 0 && args > USER_BREAK - bytes)
+    return (size_t) -1;                           // args may be NULL: then every thread gets 0
+  if (start_routine == 0 || start_routine >= USER_BREAK)
+    return (size_t) -1;
+  if (entry == 0 || entry >= USER_BREAK)
+    return (size_t) -1;
+
+  size_t arg_copy[MAX_USER_THREADS];
+  if (args)
+    memcpy(arg_copy, (void*) args, bytes);       // copy in before anything is created
+  else
+    memset(arg_copy, 0, bytes);
+  memset((void*) ids, 0, bytes);                 // touch the result array: if it faults, nothing exists yet
+
+  UserProcess* process = currentThread->getProcess();
+  UserThread* created[MAX_USER_THREADS];
+  for (size_t i = 0; i < count; ++i)
+  {
+    created[i] = process->createThread((void*) entry, true, (void*) start_routine, (void*) arg_copy[i]);
+    if (!created[i])
+    {
+      for (size_t j = 0; j < i; ++j)             // roll back: none of them is scheduled yet,
+        process->discardThread(created[j]);      // so none of them has run
+      return (size_t) -1;
+    }
+  }
+  size_t* user_ids = (size_t*) ids;
+  for (size_t i = 0; i < count; ++i)
+    user_ids[i] = created[i]->getTID();
+  for (size_t i = 0; i < count; ++i)
+    Scheduler::instance()->addNewThread(created[i]);   // only now: all or nothing
+  return 0;
+}
+
+// A1-02: join whichever of the threads exits first
+size_t Syscall::pthreadJoinAny(size_t ids, size_t count, size_t index_ptr, size_t value_ptr)
+{
+  size_t bytes = count * sizeof(size_t);
+  if (count == 0 || count > MAX_USER_THREADS)
+    return (size_t) -1;
+  if (ids == 0 || ids > USER_BREAK - bytes)
+    return (size_t) -1;
+  if (index_ptr == 0 || index_ptr > USER_BREAK - sizeof(size_t))
+    return (size_t) -1;
+  if (value_ptr != 0 && value_ptr > USER_BREAK - sizeof(void*))
+    return (size_t) -1;                           // value_ptr may be NULL
+
+  size_t id_copy[MAX_USER_THREADS];
+  memcpy(id_copy, (void*) ids, bytes);
+  size_t index = 0;
+  void* value = 0;
+  if (currentThread->getProcess()->joinAny(id_copy, count, &index, &value) != 0)
+    return (size_t) -1;
+  size_t* user_index = (size_t*) index_ptr;      // user memory only after the lock is released
+  *user_index = index;
+  if (value_ptr != 0)
+  {
+    void** user_value = (void**) value_ptr;
+    *user_value = value;
+  }
+  return 0;
+}
