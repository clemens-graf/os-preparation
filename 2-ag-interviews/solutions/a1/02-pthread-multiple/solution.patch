+// A1-02: undo createThread for a thread that never ran - nobody knows its id yet
+void UserProcess::discardThread(UserThread* thread)
+{
+  {
+    ScopeLock lock(thread_lock_);
+    UserThreadData* thread_data = findThreadData(thread);
+    assert(thread_data && "discardThread: thread is not registered");
+    freeUserThreadStack(thread_data);
+    removeThreadDataFromList(thread_data);
+    delete thread_data;
+    running_threads_--;
+  }
+  thread->setRegisteredInProcess(false);   // its destructor must not call threadExited()
+  delete thread;                           // never scheduled: we may delete it directly
+}
+
+// A1-02: like joinThread, but for whichever of the threads exits first
+size_t UserProcess::joinAny(const size_t* tids, size_t count, size_t* index, void** exit_value)
+{
+  ScopeLock lock(thread_lock_);
+  while (true)
+  {
+    bool any_joinable = false;
+    for (size_t i = 0; i < count; ++i)
+    {
+      UserThreadData* thread_data = findThreadDataByTid(tids[i]);
+      if (!thread_data || thread_data->joined_ || tids[i] == currentThread->getTID())
+        continue;                          // unknown, already being joined, or ourselves
+      if (thread_data->exited_)
+      {
+        *index = i;                        // join it - under the same lock as the check
+        *exit_value = thread_data->exit_value_;
+        removeThreadDataFromList(thread_data);
+        delete thread_data;
+        return 0;
+      }
+      any_joinable = true;                 // still running: worth waiting for
+    }
+    if (!any_joinable)
+      return (size_t) -1;                  // waiting would never end
+    thread_exited_.wait();                 // broadcast by every exitThread
+  }
+}
