+// A0-08
+size_t Syscall::pthreadCreate(size_t thread_id, size_t start_routine, size_t argument, size_t entry)
+{
+  if (thread_id == 0 || thread_id >= USER_BREAK - sizeof(size_t) || start_routine == 0 ||
+      start_routine >= USER_BREAK || entry == 0 || entry >= USER_BREAK)
+    return (size_t) -1;
