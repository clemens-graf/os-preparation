+
+void Syscall::pthreadExit(size_t value)
+{
+  debug(SYSCALL, "pthread_exit with value %zx\n", value);
+  if (currentThread->process_ == currentThread)
+    exit(0);                  // main thread: like exit(), waits for the others
+  ((UserThread*) currentThread)->exit_value_ = value;   // read by ~UserThread -> pthread_join
+  currentThread->kill();
+}
+
+// A1-01
+size_t Syscall::pthreadJoin(size_t thread_id, size_t value_ptr)
+{
+  if (value_ptr != 0 && value_ptr >= USER_BREAK - sizeof(size_t))
+    return (size_t) -1;
+  size_t value = 0;
+  if (currentThread->process_->joinThread(thread_id, &value) != 0)   // sleeps until the thread is gone
+    return (size_t) -1;
+  if (value_ptr)
+    *(size_t*) value_ptr = value;   // after joinThread released its lock: this write may page-fault
+  return 0;
+}
+
+// A1-02: count threads, all or nothing
+size_t Syscall::pthreadMultiple(size_t ids, size_t count, size_t start_routine, size_t args, size_t entry)
+{
+  size_t bytes = count * sizeof(size_t);
+  if (count == 0 || count > MAX_USER_THREADS || ids == 0 || ids >= USER_BREAK - bytes ||
+      (args != 0 && args >= USER_BREAK - bytes) || start_routine == 0 || start_routine >= USER_BREAK ||
+      entry == 0 || entry >= USER_BREAK)
+    return (size_t) -1;
+
+  size_t arg_copy[MAX_USER_THREADS];
+  if (args)
+    memcpy(arg_copy, (void*) args, bytes);       // copy in before anything is created
+  else
+    memset(arg_copy, 0, bytes);
+  memset((void*) ids, 0, bytes);                 // touch the result array: if it faults, nothing exists yet
+
+  UserProcess* process = currentThread->process_;
+  UserThread* created[MAX_USER_THREADS];
+  for (size_t i = 0; i < count; ++i)
+  {
+    created[i] = process->createThread(entry, start_routine, arg_copy[i]);
+    if (!created[i])
+    {
+      // roll back: none of them has been scheduled, so none of them has run
+      for (size_t j = 0; j < i; ++j)
+        process->discardThread(created[j]);
+      return (size_t) -1;
+    }
+  }
+  for (size_t i = 0; i < count; ++i)
+    ((size_t*) ids)[i] = created[i]->getThreadId();
+  for (size_t i = 0; i < count; ++i)
+    Scheduler::instance()->addNewThread(created[i]);   // only now: all or nothing
+  return 0;
+}
+
+// A1-02: join whichever of the threads finishes first
+size_t Syscall::pthreadJoinAny(size_t ids, size_t count, size_t index_ptr, size_t value_ptr)
+{
+  size_t bytes = count * sizeof(size_t);
+  if (count == 0 || count > MAX_USER_THREADS || ids == 0 || ids >= USER_BREAK - bytes ||
+      index_ptr == 0 || index_ptr >= USER_BREAK - sizeof(size_t) ||
+      (value_ptr != 0 && value_ptr >= USER_BREAK - sizeof(size_t)))
+    return (size_t) -1;
+  size_t id_copy[MAX_USER_THREADS];
+  memcpy(id_copy, (void*) ids, bytes);
+  size_t index = 0;
+  size_t value = 0;
+  if (currentThread->process_->joinAny(id_copy, count, &index, &value) != 0)
+    return (size_t) -1;
+  *(size_t*) index_ptr = index;                  // user memory only after the lock is released
+  if (value_ptr)
+    *(size_t*) value_ptr = value;
+  return 0;
+}
