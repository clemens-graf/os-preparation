+// A1-11: page faults of the calling process (same layout as Loader::PageFaultStats)
+struct pfstats
+{
+  size_t total;          // all page faults
+  size_t user;           // ... raised in user mode
+  size_t kernel;         // ... raised in kernel mode (a syscall touching user memory)
+  size_t writes;         // write accesses
+  size_t reads;          // read accesses (not instruction fetches)
+  size_t fetches;        // instruction fetches
+  size_t last_address;   // cr2 of the last one
+};
+extern int pfstats(struct pfstats* stats);
+
 #ifdef __cplusplus
 }
 #endif
