 extern "C" void pageFaultHandler(uint64 address, uint64 error)
 {
+  // A1-11: the asm stub (arch_interrupts.S: arch_pageFaultHandler) read cr2 and passed it as
+  // 'address'. Interrupts are still off here, no other page fault can have changed cr2 yet:
+  uint64 cr2;
+  asm volatile("mov %%cr2, %0" : "=r"(cr2));
+  assert(cr2 == address);
+
+  // statistics: interrupts are OFF here - a Mutex would assert ("Lock ... with IF=0"),
+  // so the counters are updated with atomic instructions only
+  UserProcess* process = currentThread->getProcess();   // nullptr for kernel threads
+  if (process)
+  {
+    UserProcess::PageFaultStats& stats = process->pf_stats_;
+    ArchThreads::atomic_add(stats.total, 1);
+    ArchThreads::atomic_add((error & FLAG_PF_USER) ? stats.user : stats.kernel, 1);
+    if (error & FLAG_PF_INSTR_FETCH)
+      ArchThreads::atomic_add(stats.fetches, 1);
+    else
+      ArchThreads::atomic_add((error & FLAG_PF_RDWR) ? stats.writes : stats.reads, 1);
+    ArchThreads::atomic_set(stats.last_address, address);
+  }
+
   auto &regs = *(currentThread->switch_to_userspace_ ? currentThread->user_registers_ : currentThread->kernel_registers_);
 
   if (address >= USER_BREAK && address < KERNEL_START) { // dirty hack due to qemu invoking the pf handler when accessing non canonical addresses
