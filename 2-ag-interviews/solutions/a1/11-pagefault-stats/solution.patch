diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..103651ba 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -114,6 +114,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pfstats:
+      return_value = pfStats(arg1);
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -864,3 +867,13 @@ size_t Syscall::pthreadSetCancelType(int new_type, int *oldtype)
   }
   return 0;
 }
+
+// A1-11: copy the page fault statistics of the calling process
+size_t Syscall::pfStats(size_t user_stats)
+{
+  if (user_stats == 0 || user_stats > USER_BREAK - sizeof(UserProcess::PageFaultStats))
+    return (size_t) -1;
+  UserProcess::PageFaultStats copy = currentThread->getProcess()->pf_stats_;   // snapshot first ...
+  *(UserProcess::PageFaultStats*) user_stats = copy;                           // ... this write may fault itself
+  return 0;
+}
diff --git a/userspace/libc/include/nonstd.h b/userspace/libc/include/nonstd.h
index 54687327..59e51489 100644
--- a/userspace/libc/include/nonstd.h
+++ b/userspace/libc/include/nonstd.h
@@ -1,5 +1,7 @@
 #pragma once
 
+#include "types.h"
+
 #include "../../../common/include/kernel/syscall-definitions.h"
 
 #ifdef __cplusplus
@@ -31,6 +33,19 @@ extern int getProcessCount(void);
  */
 extern unsigned long getUsedKernelMemory(void);
 
+// A1-11: page faults of the calling process (same layout as UserProcess::PageFaultStats)
+struct pfstats
+{
+  size_t total;          // all page faults
+  size_t user;           // ... raised in user mode
+  size_t kernel;         // ... raised in kernel mode (a syscall touching user memory)
+  size_t writes;         // write accesses
+  size_t reads;          // read accesses (not instruction fetches)
+  size_t fetches;        // instruction fetches
+  size_t last_address;   // cr2 of the last one
+};
+extern int pfstats(struct pfstats* stats);
+
 #ifdef __cplusplus
 }
 #endif
