+
+// A1-11: copy the page fault statistics of the calling process
+size_t Syscall::pfStats(size_t user_stats)
+{
+  if (user_stats == 0 || user_stats >= USER_BREAK - sizeof(Loader::PageFaultStats))
+    return (size_t) -1;
+  Loader::PageFaultStats copy = currentThread->loader_->pf_stats_;   // snapshot first ...
+  *(Loader::PageFaultStats*) user_stats = copy;                      // ... this write may fault itself
+  return 0;
+}
