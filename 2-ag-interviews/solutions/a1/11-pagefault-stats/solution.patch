+
+// A1-11: copy the page fault statistics of the calling process
+size_t Syscall::pfStats(size_t user_stats)
+{
+  if (user_stats == 0 || user_stats > USER_BREAK - sizeof(UserProcess::PageFaultStats))
+    return (size_t) -1;
+  UserProcess::PageFaultStats copy = currentThread->getProcess()->pf_stats_;   // snapshot first ...
+  *(UserProcess::PageFaultStats*) user_stats = copy;                           // ... this write may fault itself
+  return 0;
+}
