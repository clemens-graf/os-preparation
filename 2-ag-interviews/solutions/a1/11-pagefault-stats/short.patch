diff --git a/arch/x86/64/source/InterruptUtils.cpp b/arch/x86/64/source/InterruptUtils.cpp
index 65609d67..659e88d4 100644
--- a/arch/x86/64/source/InterruptUtils.cpp
+++ b/arch/x86/64/source/InterruptUtils.cpp
@@ -197,6 +197,27 @@ extern "C" void pageFaultHandler(uint64 address, uint64 error)
 
   assert((regs.rflags&(1ULL<<9)) && "PF with interrupts disabled. PF handler will enable interrupts soon. Better panic now");
 
+  uint64 cr2;
+  asm volatile("mov %%cr2, %0" : "=r"(cr2));        // A1-11: the CPU's fault address register
+  assert(cr2 == address);
+  UserProcess* process = currentThread->getProcess();
+  if (process)
+  {
+    size_t* stats = process->pf_stats_;
+    stats[0]++;
+    if (error & FLAG_PF_USER)
+      stats[1]++;
+    else
+      stats[2]++;
+    if (error & FLAG_PF_INSTR_FETCH)
+      stats[5]++;
+    else if (error & FLAG_PF_RDWR)
+      stats[3]++;
+    else
+      stats[4]++;
+    stats[6] = address;
+  }
+
   PageFaultHandler::enterPageFault(address, error & FLAG_PF_USER,
                                    error & FLAG_PF_PRESENT,
                                    error & FLAG_PF_RDWR,
