@@ -89,6 +89,20 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pfstats:
+    {
+      if (arg1 == 0 || arg1 >= USER_BREAK)
+      {
+        return_value = -1;
+        break;
+      }
+      size_t copy[7];                                    // copy first: the write below may fault itself
+      for (size_t i = 0; i < 7; ++i)
+        copy[i] = currentThread->getProcess()->pf_stats_[i];
+      for (size_t i = 0; i < 7; ++i)
+        ((size_t*) arg1)[i] = copy[i];
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
