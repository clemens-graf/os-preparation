@@ -540,3 +548,26 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-09: virtual address -> physical page number of the calling process (-1 if not mapped)
+size_t Syscall::vtop(size_t address)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());          // the page-table lock of your team's code
+  ArchMemoryMapping m = process->getAddressSpace().resolveMapping(address / PAGE_SIZE);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;
+  return m.page_ppn;
+}
+
+// A1-09: physical page number -> lowest virtual address that maps it in the calling process (0 if none)
+size_t Syscall::ptov(size_t ppn)
+{
+  if (ppn == 0 || ppn >= PageManager::instance()->getTotalNumPages())
+    return 0;
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());
+  return process->getAddressSpace().findVirtualPage(ppn) * PAGE_SIZE;
+}
