+
+// A1-09: virtual address -> physical page number of the calling process (-1 if not mapped)
+size_t Syscall::vtop(size_t address)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);
+  ArchMemoryMapping m = loader->arch_memory_.resolveMapping(address / PAGE_SIZE);
+  if (m.page_size != PAGE_SIZE)
+    return (size_t) -1;
+  return m.page_ppn;
+}
+
+// A1-09: physical page number -> lowest virtual address that maps it in the calling process (0 if none)
+size_t Syscall::ptov(size_t ppn)
+{
+  if (ppn == 0 || ppn >= PageManager::instance()->getTotalNumPages())
+    return 0;
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);
+  return loader->arch_memory_.findVirtualPage(ppn) * PAGE_SIZE;
+}
