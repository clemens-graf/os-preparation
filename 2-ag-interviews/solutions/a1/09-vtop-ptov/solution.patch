@@ -360,3 +360,36 @@ void ArchMemory::flushTlb()
 {
   asm volatile ("movq %%cr3, %%rax; movq %%rax, %%cr3;" ::: "%rax", "memory");
 }
+
+// A1-09
+size_t ArchMemory::findVirtualPage(size_t ppn)
+{
+  // the reverse direction has no shortcut: walk every present entry of the user half
+  PageMapLevel4Entry* pml4 = (PageMapLevel4Entry*) getIdentAddressOfPPN(page_map_level_4_);
+  for (uint64 pml4i = 0; pml4i < PAGE_MAP_LEVEL_4_ENTRIES / 2; pml4i++)
+  {
+    if (!pml4[pml4i].present)
+      continue;
+    PageDirPointerTableEntry* pdpt = (PageDirPointerTableEntry*) getIdentAddressOfPPN(pml4[pml4i].page_ppn);
+    for (uint64 pdpti = 0; pdpti < PAGE_DIR_POINTER_TABLE_ENTRIES; pdpti++)
+    {
+      if (!pdpt[pdpti].pd.present)
+        continue;
+      PageDirEntry* pd = (PageDirEntry*) getIdentAddressOfPPN(pdpt[pdpti].pd.page_ppn);
+      for (uint64 pdi = 0; pdi < PAGE_DIR_ENTRIES; pdi++)
+      {
+        if (!pd[pdi].pt.present)
+          continue;
+        PageTableEntry* pt = (PageTableEntry*) getIdentAddressOfPPN(pd[pdi].pt.page_ppn);
+        for (uint64 pti = 0; pti < PAGE_TABLE_ENTRIES; pti++)
+        {
+          if (pt[pti].present && pt[pti].page_ppn == ppn)
+            // the four indices ARE the virtual page number: 9 bits per level
+            return (((pml4i * PAGE_DIR_POINTER_TABLE_ENTRIES + pdpti) * PAGE_DIR_ENTRIES + pdi)
+                    * PAGE_TABLE_ENTRIES + pti);
+        }
+      }
+    }
+  }
+  return 0;
+}
