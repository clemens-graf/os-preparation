--- a/arch/x86/64/source/ArchMemory.cpp
+++ b/arch/x86/64/source/ArchMemory.cpp
@@ -360,3 +360,30 @@ void ArchMemory::flushTlb()
 {
   asm volatile ("movq %%cr3, %%rax; movq %%rax, %%cr3;" ::: "%rax", "memory");
 }
+
+size_t ArchMemory::findVirtualPage(size_t ppn)
+{
+  PageMapLevel4Entry* pml4 = (PageMapLevel4Entry*) getIdentAddressOfPPN(page_map_level_4_);
+  for (size_t i4 = 0; i4 < PAGE_MAP_LEVEL_4_ENTRIES / 2; i4++)         // user half only
+  {
+    if (!pml4[i4].present)
+      continue;
+    PageDirPointerTableEntry* pdpt = (PageDirPointerTableEntry*) getIdentAddressOfPPN(pml4[i4].page_ppn);
+    for (size_t i3 = 0; i3 < PAGE_DIR_POINTER_TABLE_ENTRIES; i3++)
+    {
+      if (!pdpt[i3].pd.present)
+        continue;
+      PageDirEntry* pd = (PageDirEntry*) getIdentAddressOfPPN(pdpt[i3].pd.page_ppn);
+      for (size_t i2 = 0; i2 < PAGE_DIR_ENTRIES; i2++)
+      {
+        if (!pd[i2].pt.present)
+          continue;
+        PageTableEntry* pt = (PageTableEntry*) getIdentAddressOfPPN(pd[i2].pt.page_ppn);
+        for (size_t i1 = 0; i1 < PAGE_TABLE_ENTRIES; i1++)
+          if (pt[i1].present && pt[i1].page_ppn == ppn)
+            return ((i4 * 512 + i3) * 512 + i2) * 512 + i1;   // the four indices = the vpn
+      }
+    }
+  }
+  return 0;
+}
