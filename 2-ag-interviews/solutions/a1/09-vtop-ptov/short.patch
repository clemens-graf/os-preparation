@@ -89,6 +90,24 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_vtop:
+    {
+      if (arg1 >= USER_BREAK)
+        return_value = -1;
+      else
+      {
+        ScopeLock lock(currentThread->getProcess()->getThreadLock());
+        ArchMemoryMapping m = currentThread->getProcess()->getAddressSpace().resolveMapping(arg1 / PAGE_SIZE);
+        return_value = m.page_size == PAGE_SIZE ? m.page_ppn : (size_t) -1;
+      }
+      break;
+    }
+    case sc_ptov:
+    {
+      ScopeLock lock(currentThread->getProcess()->getThreadLock());
+      return_value = currentThread->getProcess()->getAddressSpace().findVirtualPage(arg1) * PAGE_SIZE;
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
