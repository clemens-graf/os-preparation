 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -88,6 +89,12 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
+    case sc_thread_runtime:
+      return_value = threadRuntime(arg1);
+      break;
+    case sc_process_ticks:
+      return_value = currentThread->getProcess()->getProcessTicks();
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -448,3 +455,16 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-07: CPU ticks of a thread of the calling process (0 = the calling thread)
+size_t Syscall::threadRuntime(size_t thread_id)
+{
+  if (thread_id == 0)
+    return currentThread->cpu_ticks_;
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());   // exitThread clears thread_ under this lock
+  UserThreadData* thread_data = process->findThreadDataByTid(thread_id);
+  if (!thread_data || !thread_data->thread_)
+    return (size_t) -1;                       // unknown, or no longer running
+  return thread_data->thread_->cpu_ticks_;
+}
diff --git a/common/source/kernel/UserProcess.cpp b/common/source/kernel/UserProcess.cpp
