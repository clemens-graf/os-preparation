 #include "ArchMemory.h"
 
 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, int fd, uint32 ppid, ArchMemory* arch_memory) :
@@ -410,6 +411,7 @@ void UserProcess::exitThread(void* exit_value)
   freeUserThreadStack(thread_data);
 
   thread_data->exit_value_ = exit_value;
+  finished_ticks_ += thread->cpu_ticks_;   // A1-07: keep its time after the object is gone
   thread_data->thread_ = nullptr;
   thread_data->exited_ = true;
   thread_exited_.broadcast();
@@ -550,3 +552,16 @@ void UserProcess::exitProcess()
   thread_lock_.release();
 
 }
+
+// A1-07
+size_t UserProcess::getProcessTicks()
+{
+  ScopeLock lock(thread_lock_);
+  size_t ticks = finished_ticks_;                       // threads that are gone
+  for (size_t i = 0; i < threads_.size(); i++)
+  {
+    if (threads_[i] && threads_[i]->thread_)            // still running (the main thread too)
+      ticks += threads_[i]->thread_->cpu_ticks_;
+  }
+  return ticks;
+}
