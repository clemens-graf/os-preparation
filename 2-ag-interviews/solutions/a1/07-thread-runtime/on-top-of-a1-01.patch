+Thread* UserProcess::findThread(size_t id)
+{
+  assert(threads_lock_.isHeldBy(currentThread));
+  if (id == 0)
+    return this;
+  for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+  {
+    if (slots_[slot].state == SLOT_RUNNING && slots_[slot].id == id)
+      return (Thread*) slots_[slot].thread;   // may still be nullptr right after creation
+  }
+  return nullptr;
+}
+
+size_t UserProcess::getProcessTicks()
+{
+  ScopeLock lock(threads_lock_);
+  size_t ticks = cpu_ticks_ + finished_ticks_;          // main thread + threads that are gone
+  for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+  {
+    if (slots_[slot].state == SLOT_RUNNING && slots_[slot].thread)
+      ticks += slots_[slot].thread->cpu_ticks_;
+  }
+  return ticks;
+}
