 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -89,6 +90,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_invoke:
+      return_value = pthreadInvoke(arg1);
+      break;
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
@@ -540,3 +544,21 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-05: the thread with id thread_id runs next, the caller gives up the CPU
+size_t Syscall::pthreadInvoke(size_t thread_id)
+{
+  UserProcess* process = currentThread->getProcess();
+  Thread* target = nullptr;
+  {
+    ScopeLock lock(process->getThreadLock());
+    UserThreadData* data = process->findThreadDataByTid(thread_id);
+    if (data && data->thread_ != currentThread)
+      target = data->thread_;
+  }                                             // never yield while holding a lock
+  if (!target)
+    return (size_t) -1;                         // unknown, ended, or the caller itself
+  Scheduler::instance()->preferred_ = target;
+  Scheduler::instance()->yield();
+  return 0;
+}
