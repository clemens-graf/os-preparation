diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 178fc3a2..5535be29 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,7 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -89,6 +90,24 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_invoke:
+    {
+      Thread* target = nullptr;
+      {
+        ScopeLock lock(currentThread->getProcess()->getThreadLock());
+        UserThreadData* data = currentThread->getProcess()->findThreadDataByTid(arg1);
+        if (data && data->thread_ != currentThread)
+          target = data->thread_;
+      }
+      if (!target)
+      {
+        return_value = -1;
+        break;
+      }
+      Scheduler::instance()->preferred_ = target;   // never yield while holding a lock
+      Scheduler::instance()->yield();
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
