+  auto it = threads_.end();
+  for (auto c = threads_.begin(); c != threads_.end(); ++c)    // A1-05: the invoked thread first
+    if (*c == preferred_ && (*c)->schedulable())
+      it = c;
+  preferred_ = nullptr;
+  if (it == threads_.end())                                    // otherwise round robin as before
+    for (it = threads_.begin(); it != threads_.end() && !(*it)->schedulable(); ++it) {}
+  if (it != threads_.end())
+    currentThread = *it;
 
   assert(it != threads_.end() && "No schedulable thread found");
