+
+// A1-05: the thread with id thread_id runs next, the caller gives up the CPU
+size_t Syscall::pthreadInvoke(size_t thread_id)
+{
+  UserProcess* process = currentThread->getProcess();
+  Thread* target = nullptr;
+  {
+    ScopeLock lock(process->getThreadLock());
+    UserThreadData* data = process->findThreadData(thread_id);
+    if (data && data->thread_ != currentThread)
+      target = data->thread_;
+  }                                             // never yield while holding a lock
+  if (!target)
+    return (size_t) -1;                         // unknown, ended, or the caller itself
+  Scheduler::instance()->preferred_ = target;
+  Scheduler::instance()->yield();
+  return 0;
+}
