+Thread* UserProcess::findThread(size_t id)
+{
+  assert(threads_lock_.isHeldBy(currentThread));
+  if (id == 0)
+    return this;
+  for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+  {
+    if (slots_[slot].state == SLOT_RUNNING && slots_[slot].id == id)
