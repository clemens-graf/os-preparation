diff --git a/common/source/kernel/Scheduler.cpp b/common/source/kernel/Scheduler.cpp
index 7e94ab12..c488af6f 100644
--- a/common/source/kernel/Scheduler.cpp
+++ b/common/source/kernel/Scheduler.cpp
@@ -49,15 +49,21 @@ void Scheduler::schedule()
     debug(SCHEDULER, "schedule: WARNING - cleanup_thread is being descheduled before completing cleanup.\n");
   }
 
+  // A1-05: a directed yield wins - if that thread is still in the list (it may have been
+  // destroyed since yieldTo) and runnable
+  Thread* preferred = preferred_;
+  preferred_ = nullptr;
   auto it = threads_.begin();
-  for(; it != threads_.end(); ++it)
+  while (preferred && it != threads_.end() && !(*it == preferred && (*it)->schedulable()))
+    ++it;
+  if (!preferred || it == threads_.end())          // no directed yield (or that thread is gone)
   {
-    if((*it)->schedulable())
-    {
-      currentThread = *it;
-      break;
-    }
+    for (it = threads_.begin(); it != threads_.end(); ++it)   // normal round robin
+      if ((*it)->schedulable())
+        break;
   }
+  if (it != threads_.end())
+    currentThread = *it;
 
   assert(it != threads_.end() && "No schedulable thread found");
   ustl::rotate(threads_.begin(), it + 1, threads_.end()); // no new/delete here - important because interrupts are disabled
@@ -236,3 +242,10 @@ size_t Scheduler::getThreadCount()
   unlockScheduling();
   return thread_count;
 }
+
+// A1-05
+void Scheduler::yieldTo(Thread* thread)
+{
+  preferred_ = thread;    // a single pointer store: schedule() sees either the old or the new value
+  yield();
+}
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 86cf85a2..5e78a629 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,7 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -88,6 +89,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
+    case sc_pthread_invoke:
+      return_value = pthreadInvoke(arg1);
+      break;
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
@@ -448,3 +452,21 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// A1-05: let thread_id run next
+size_t Syscall::pthreadInvoke(size_t thread_id)
+{
+  UserProcess* process = currentThread->getProcess();
+  Thread* target;
+  {
+    ScopeLock lock(process->getThreadLock());
+    UserThreadData* thread_data = process->findThreadDataByTid(thread_id);
+    if (!thread_data || !thread_data->thread_ || thread_data->thread_ == currentThread)
+      return (size_t) -1;
+    target = thread_data->thread_;
+  }
+  // never yield while holding a lock. After the release the thread may die - that is fine:
+  // the scheduler only compares the pointer with its list
+  Scheduler::instance()->yieldTo(target);
+  return 0;
+}
