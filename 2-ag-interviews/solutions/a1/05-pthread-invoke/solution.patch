+  for (size_t slot = 1; slot <= MAX_USER_THREADS; ++slot)
+  {
+    if (slots_[slot].state == SLOT_RUNNING && slots_[slot].id == id)
+      return (Thread*) slots_[slot].thread;   // may still be nullptr right after creation
+  }
+  return nullptr;
+}
diff --git a/common/source/kernel/UserThread.cpp b/common/source/kernel/UserThread.cpp
new file mode 100644
index 0000000..3886713
--- /dev/null
+++ b/common/source/kernel/UserThread.cpp
@@ -0,0 +1,64 @@
+#include "UserThread.h"
+#include "UserProcess.h"
+#include "Loader.h"
+#include "ArchMemory.h"
+#include "ArchThreads.h"
+#include "PageManager.h"
+#include "kprintf.h"
+
+UserThread::UserThread(UserProcess* process, size_t stack_slot, size_t thread_id, size_t entry,
+                       size_t start_routine, size_t argument) :
+    Thread(process->getWorkingDirInfo(), process->getName(), Thread::USER_THREAD),
+    exit_value_((size_t) -1), stack_slot_(stack_slot), thread_id_(thread_id)
+{
+  process_ = process;
+  loader_ = process->loader_;                      // same loader = same address space
+
+  // 1. the stack: map the top pages of this thread's slot
+  for (size_t i = 1; i <= USER_THREAD_STACK_PAGES; ++i)
+  {
+    size_t ppn = PageManager::instance()->allocPPN();
+    loader_->arch_memory_lock_.acquire();
+    bool mapped = loader_->arch_memory_.mapPage(stackTop() / PAGE_SIZE - i, ppn, 1);
+    loader_->arch_memory_lock_.release();
+    assert(mapped && "a slot's stack is unmapped before the slot is reused");
+  }
+
+  // 2. the registers: start in the libc entry function, entry(start_routine, argument)
+  ArchThreads::createUserRegisters(user_registers_, (void*) entry, (void*) (stackTop() - sizeof(pointer)),
+                                   getKernelStackStartPointer());
+  user_registers_->rdi = start_routine;            // 1st argument
+  user_registers_->rsi = argument;                 // 2nd argument
+
+  // 3. the address space: cr3 of the process
+  ArchThreads::setAddressSpace(this, loader_->arch_memory_);
+  setTerminal(process->getTerminal());
+  debug(USERPROCESS, "UserThread %zu created, stack top %zx\n", getThreadId(), stackTop());
+}
+
+UserThread::~UserThread()
+{
+  // runs in the CleanupThread - this thread will never run again, its stack is free
+  loader_->arch_memory_lock_.acquire();
+  for (size_t i = 1; i <= USER_THREAD_STACK_PAGES; ++i)
+    loader_->arch_memory_.unmapPage(stackTop() / PAGE_SIZE - i);
+  loader_->arch_memory_lock_.release();
+
+  // last line on purpose: once the process knows we are gone, it may delete loader_
+  process_->threadFinished(stack_slot_, exit_value_);
+}
+
+void UserThread::Run()
+{
+  assert(false && "user threads do not run in kernel mode");
+}
+
+size_t UserThread::getThreadId() const
+{
+  return thread_id_;
+}
+
+size_t UserThread::stackTop() const
+{
+  return USER_BREAK - stack_slot_ * STACK_SLOT_SIZE;
+}
