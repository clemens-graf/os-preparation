+
+size_t UserProcess::joinThread(size_t id, size_t* exit_value)
+{
+  ScopeLock lock(threads_lock_);
+  size_t slot = 1;
+  while (slot <= MAX_USER_THREADS && (slots_[slot].state == SLOT_FREE || slots_[slot].id != id))
+    ++slot;
+  if (slot > MAX_USER_THREADS)
+    return (size_t) -1;                                   // no such thread, or already joined
+  if (currentThread != this && ((UserThread*) currentThread)->getThreadId() == id)
+    return (size_t) -1;                                   // joining yourself would never end
+
+  // the slot may be joined by someone else while we sleep, and then reused by a new thread:
+  // re-check that it is still OUR thread after every wake-up
+  while (slots_[slot].state == SLOT_RUNNING && slots_[slot].id == id)
+    threads_changed_.wait();
+  if (slots_[slot].state != SLOT_FINISHED || slots_[slot].id != id)
+    return (size_t) -1;                                   // another joiner was faster
+
+  *exit_value = slots_[slot].exit_value;
+  slots_[slot].state = SLOT_FREE;                         // the slot (and stack area) can be reused
+  return 0;
+}
+
+void UserProcess::waitForThreads()
+{
+  threads_lock_.acquire();
+  while (num_threads_ > 0)
+    threads_changed_.wait();
+  threads_lock_.release();
