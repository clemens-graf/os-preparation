diff --git a/userspace/libc/src/pthread.c b/userspace/libc/src/pthread.c
index 8b8448e4..70d33887 100644
--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -231,3 +231,16 @@ int pthread_setcanceltype(int type, int *oldtype)
 {
   return -1;
 }
+
+static void pthreadMultiStart(void* (**functions)(void*), void** arguments, size_t count)
+{
+  for (size_t i = 0; i < count; ++i)
+    functions[i](arguments[i]);
+  pthread_exit(0);
+}
+
+int pthread_multi(pthread_t* thread, void* (**functions)(void*), void** arguments, size_t count)
+{
+  return __syscall(sc_pthread_multi, (size_t) thread, (size_t) functions, (size_t) arguments, count,
+                   (size_t) pthreadMultiStart);
+}
