@@ -62,6 +62,8 @@ extern int pthread_cond_wait(pthread_cond_t *cond, pthread_mutex_t *mutex);
 
 extern int pthread_setcancelstate(int state, int *oldstate);
 
+extern int pthread_multi(pthread_t* thread, void* (**functions)(void*), void** arguments, size_t count);
