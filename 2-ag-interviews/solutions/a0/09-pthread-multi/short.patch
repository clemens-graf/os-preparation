diff --git a/common/include/kernel/syscall-definitions.h b/common/include/kernel/syscall-definitions.h
index 290b5459..0e9dba33 100644
--- a/common/include/kernel/syscall-definitions.h
+++ b/common/include/kernel/syscall-definitions.h
@@ -44,6 +44,7 @@
 #define sc_pthread_detach 1504
 #define sc_pthread_setcancelstate 1505
 #define sc_pthread_setcanceltype 1506
+#define sc_pthread_multi 1552
 #define sc_thread_count 1998
 #define sc_process_count 1999
 #define PTHREAD_CANCELED ((void*) -1)
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..a7da7200 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,8 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "kstring.h"
+#include "ArchThreads.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +116,41 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_pthread_multi:
+    {
+      size_t count = arg4;
+      size_t functions[16];
+      size_t arguments[16];
+      if (count == 0 || count > 16)
+      {
+        return_value = -1;
+        break;
+      }
+      memcpy(functions, (void*) arg2, count * sizeof(size_t));   // copy now: the caller may reuse its arrays
+      memcpy(arguments, (void*) arg3, count * sizeof(size_t));
+      bool ok = true;
+      for (size_t i = 0; i < count; ++i)
+        if (functions[i] == 0 || functions[i] >= USER_BREAK)
+          ok = false;
+      UserThread* thread = ok ? process->createThread((void*) arg5, false, 0, 0) : nullptr;
+      if (!thread)
+      {
+        return_value = -1;
+        break;
+      }
+      // put both arrays on the new thread's stack (same address space: we can write it directly)
+      ArchThreadRegisters* regs = thread->user_registers_;
+      size_t* stack = (size_t*) (regs->rsp - 32 * sizeof(size_t));
+      memcpy(stack, functions, count * sizeof(size_t));
+      memcpy(stack + 16, arguments, count * sizeof(size_t));
+      regs->rdi = (size_t) stack;                // pthreadMultiStart(functions, arguments, count)
+      regs->rsi = (size_t) (stack + 16);
+      regs->rdx = count;
+      regs->rsp = (size_t) stack - sizeof(size_t);   // as if it had been called
+      *(size_t*) arg1 = thread->getTID();
+      Scheduler::instance()->addNewThread(thread);
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
diff --git a/userspace/libc/include/pthread.h b/userspace/libc/include/pthread.h
index acdce2f0..784e21ce 100644
--- a/userspace/libc/include/pthread.h
+++ b/userspace/libc/include/pthread.h
@@ -61,6 +61,8 @@ extern int pthread_cond_wait(pthread_cond_t *cond, pthread_mutex_t *mutex);
 
 extern int pthread_setcancelstate(int state, int *oldstate);
 
+extern int pthread_multi(pthread_t* thread, void* (**functions)(void*), void** arguments, size_t count);
+
 extern int pthread_setcanceltype(int type, int *oldtype);
 
 #ifdef __cplusplus
diff --git a/userspace/libc/src/pthread.c b/userspace/libc/src/pthread.c
index 75e67a42..d2e22e0b 100644
--- a/userspace/libc/src/pthread.c
+++ b/userspace/libc/src/pthread.c
@@ -240,3 +240,16 @@ int pthread_setcanceltype(int type, int *oldtype)
   }
   return __syscall(sc_pthread_setcanceltype, (size_t)type, (size_t)oldtype, 0x00, 0x00, 0x00);
 }
+
+static void pthreadMultiStart(void* (**functions)(void*), void** arguments, size_t count)
+{
+  for (size_t i = 0; i < count; ++i)
+    functions[i](arguments[i]);
+  pthread_exit(0);
+}
+
+int pthread_multi(pthread_t* thread, void* (**functions)(void*), void** arguments, size_t count)
+{
+  return __syscall(sc_pthread_multi, (size_t) thread, (size_t) functions, (size_t) arguments, count,
+                   (size_t) pthreadMultiStart);
+}
