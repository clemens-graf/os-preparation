+
+size_t UserThread::pushToStack(const void* data, size_t size)
+{
+  size_t user_address = (user_registers_->rsp - size) & ~0xFULL;
+  // the initially mapped stack page only (lowest_mapped_stack_vpn_): enough for 2 * 16 pointers
+  assert(user_address >= lowest_mapped_stack_vpn_ * PAGE_SIZE && "does not fit on the mapped stack page");
+
+  // write through the ident mapping, page by page: correct no matter which address space
+  // is active right now (for a thread of the same process it is ours - in fork it would not be)
+  UserProcess* process = getProcess();
+  ScopeLock lock(process->getThreadLock());
+  for (size_t done = 0; done < size;)
+  {
+    size_t address = user_address + done;
+    size_t chunk = ustl::min(size - done, PAGE_SIZE - address % PAGE_SIZE);
+    pointer kernel_address = process->getAddressSpace().checkAddressValid(address);
+    assert(kernel_address && "stack page not mapped");
+    memcpy((void*) kernel_address, (const char*) data + done, chunk);
+    done += chunk;
+  }
+  user_registers_->rsp = user_address - sizeof(pointer);  // as if the entry function had been called
+  return user_address;
+}
