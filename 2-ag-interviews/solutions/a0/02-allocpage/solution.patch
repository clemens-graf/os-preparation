+// A0-02: a region of 512 pages that user space manages page by page
+#define ALLOC_REGION_START 0x0000500000000000ULL
+#define ALLOC_REGION_PAGES 512
+
+size_t Syscall::allocPage()
+{
+  UserProcess* process = currentThread->getProcess();
+  size_t first_vpn = ALLOC_REGION_START / PAGE_SIZE;
+  size_t ppn = PageManager::instance()->allocPPN();     // before taking the lock: keep it short
+
+  {
+    // search + map must be ONE critical section: otherwise two threads find the same free
+    // slot, the second mapPage() fails and its caller gets an address it does not own
+    ScopeLock lock(process->getThreadLock());
+    for (size_t vpn = first_vpn; vpn < first_vpn + ALLOC_REGION_PAGES; ++vpn)
+    {
+      if (process->getAddressSpace().resolveMapping(vpn).page_size != 0)
+        continue;                                        // slot in use
+      bool mapped = process->getAddressSpace().mapPage(vpn, ppn, 1);
+      assert(mapped && "we hold the lock and the slot was free");
+      return vpn * PAGE_SIZE;
+    }
+  }
+  PageManager::instance()->freePPN(ppn);                // region full
+  return 0;
+}
+
+size_t Syscall::freePage(size_t address)
+{
+  if (address % PAGE_SIZE != 0 || address < ALLOC_REGION_START ||
+      address >= ALLOC_REGION_START + ALLOC_REGION_PAGES * PAGE_SIZE)
+    return (size_t) -1;
+
+  UserProcess* process = currentThread->getProcess();
+  ScopeLock lock(process->getThreadLock());
+  if (process->getAddressSpace().resolveMapping(address / PAGE_SIZE).page_size == 0)
+    return (size_t) -1;                                  // not mapped: double free
+  process->getAddressSpace().unmapPage(address / PAGE_SIZE);   // also frees the physical page
+  ArchMemory::flushTlb();                                // unmapPage does NOT flush: stale TLB entry
+  return 0;                                              // would still let us use the freed page
+}
