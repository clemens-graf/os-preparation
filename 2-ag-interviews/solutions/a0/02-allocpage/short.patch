diff --git a/userspace/libc/src/nonstd.c b/userspace/libc/src/nonstd.c
index 4c40ec43..ddb5745b 100644
--- a/userspace/libc/src/nonstd.c
+++ b/userspace/libc/src/nonstd.c
@@ -29,3 +29,13 @@ unsigned long getUsedKernelMemory(void)
 {
   return __syscall(sc_get_used_kernel_memory, 0x00, 0x00, 0x00, 0x00, 0x00);
 }
+
+void* allocpage(void)
+{
+  return (void*) __syscall(sc_allocpage, 0x00, 0x00, 0x00, 0x00, 0x00);
+}
+
+int freepage(void* page)
+{
+  return __syscall(sc_freepage, (size_t) page, 0x00, 0x00, 0x00, 0x00);
+}
