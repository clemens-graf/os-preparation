diff --git a/common/include/kernel/syscall-definitions.h b/common/include/kernel/syscall-definitions.h
index 290b5459..9f0e4d37 100644
--- a/common/include/kernel/syscall-definitions.h
+++ b/common/include/kernel/syscall-definitions.h
@@ -44,6 +44,8 @@
 #define sc_pthread_detach 1504
 #define sc_pthread_setcancelstate 1505
 #define sc_pthread_setcanceltype 1506
+#define sc_allocpage 1510
+#define sc_freepage 1511
 #define sc_thread_count 1998
 #define sc_process_count 1999
 #define PTHREAD_CANCELED ((void*) -1)
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 439b092c..5f0bff21 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -11,6 +11,8 @@
 #include "UserThread.h"
 #include "Clock.h"
 #include "KernelMemoryManager.h"
+#include "ScopeLock.h"
+#include "PageManager.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +116,35 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_allocpage:                             // the lowest free page of 512 at 0x500000000000
+    {
+      size_t first = 0x500000000000ULL / PAGE_SIZE;
+      ScopeLock lock(process->getProcessLock());   // page tables: process_lock_
+      return_value = 0;
+      for (size_t vpn = first; vpn < first + 512 && return_value == 0; ++vpn)
+      {
+        if (process->getAddressSpace().resolveMapping(vpn).page_size != 0)
+          continue;                                // slot in use
+        bool mapped = process->getAddressSpace().mapPage(vpn, PageManager::instance()->allocPPN(), 1);
+        assert(mapped);
+        return_value = vpn * PAGE_SIZE;
+      }
+      break;
+    }
+    case sc_freepage:
+    {
+      size_t vpn = arg1 / PAGE_SIZE;
+      ScopeLock lock(process->getProcessLock());   // page tables: process_lock_
+      if (arg1 % PAGE_SIZE != 0 || vpn < 0x500000000000ULL / PAGE_SIZE || vpn >= 0x500000000000ULL / PAGE_SIZE + 512
+          || process->getAddressSpace().resolveMapping(vpn).page_size == 0)
+      {
+        return_value = -1;                         // unaligned, outside the region, or not mapped
+        break;
+      }
+      process->getAddressSpace().unmapPage(vpn);   // also frees the physical page
+      ArchMemory::flushTlb();
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
