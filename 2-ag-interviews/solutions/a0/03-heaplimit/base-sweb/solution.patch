+// A0-03: set the size of the lazy heap; shrinking unmaps everything above the new size
+size_t Syscall::heapLimit(size_t size)
+{
+  if (size > HEAP_MAX_SIZE)
+    return (size_t) -1;
+  size = (size + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);        // round up to whole pages
+
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);
+  for (size_t vpn = (HEAP_START + size) / PAGE_SIZE; vpn < (HEAP_START + loader->heap_size_) / PAGE_SIZE; ++vpn)
+  {
+    if (loader->arch_memory_.resolveMapping(vpn).page_size != 0)
+      loader->arch_memory_.unmapPage(vpn);
+  }
+  ArchMemory::flushTlb();
+  loader->heap_size_ = size;
+  return 0;
+}
