 UserProcess::UserProcess(ustl::string minixfs_filename, FileSystemInfo* fs_info, uint32 terminal_number, Loader* loader, size_t ppid, ArchMemory* arch_memory) :
   filename_(minixfs_filename), working_dir_(fs_info), terminal_number_(terminal_number), loader_(loader),
@@ -936,3 +937,24 @@ void UserProcess::addCpuCycles(uint64 cycles)
 {
   cpu_cycles_ += cycles;
 }
+
+bool UserProcess::mapHeapPage(size_t vpn)
+{
+  ScopeLock lock(process_lock_);   // page tables: process_lock_
+  if (vpn * PAGE_SIZE >= HEAP_START + heap_size_)
+    return false;                                   // above the limit
+  size_t ppn = PageManager::instance()->allocPPN();
+  if (!arch_memory_->mapPage(vpn, ppn, 1))
+    PageManager::instance()->freePPN(ppn);         // another thread was faster
+  return true;
+}
+
+void UserProcess::setHeapLimit(size_t size)
+{
+  ScopeLock lock(process_lock_);   // page tables: process_lock_
+  for (size_t vpn = (HEAP_START + size) / PAGE_SIZE; vpn < (HEAP_START + heap_size_) / PAGE_SIZE; vpn++)
+    if (arch_memory_->resolveMapping(vpn).page_size != 0)   // shrinking: remove the mapped pages above
+      arch_memory_->unmapPage(vpn);
+  ArchMemory::flushTlb();
+  heap_size_ = size;
+}
