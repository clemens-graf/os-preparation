+// A0-03: set the size of the lazy heap; shrinking unmaps everything above the new size
+size_t Syscall::heapLimit(size_t size)
+{
+  if (size > HEAP_MAX_SIZE)
+    return (size_t) -1;
+  if (size % PAGE_SIZE != 0)
+    size = size + (PAGE_SIZE - size % PAGE_SIZE);        // round up to whole pages
+
+  currentThread->getProcess()->setHeapLimit(size);    // per-process state: UserProcess
+  return 0;
+}
