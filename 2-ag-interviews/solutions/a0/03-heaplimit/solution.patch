+bool UserProcess::mapHeapPage(size_t vpn)
+{
+  size_t ppn = PageManager::instance()->allocPPN();
+  thread_lock_.acquire();
+  // check the limit and map in ONE critical section: setHeapLimit() could shrink the heap
+  // between a check and a later mapPage(), leaving a page mapped above the limit
+  bool inside = vpn * PAGE_SIZE < HEAP_START + heap_size_;
+  bool mapped = false;
+  if (inside)
+    mapped = arch_memory_->mapPage(vpn, ppn, 1);       // false: another thread mapped it first
+  thread_lock_.release();
+  if (!mapped)
+    PageManager::instance()->freePPN(ppn);   // above the limit, or another thread mapped it first
+  return inside;
+}
+
+void UserProcess::setHeapLimit(size_t size)
+{
+  ScopeLock lock(thread_lock_);
+  size_t first_vpn = (HEAP_START + size) / PAGE_SIZE;       // first page above the new limit
+  size_t end_vpn = (HEAP_START + heap_size_) / PAGE_SIZE;   // end of the old heap
+  for (size_t vpn = first_vpn; vpn < end_vpn; vpn++)
+  {
+    if (arch_memory_->resolveMapping(vpn).page_size != 0)
+      arch_memory_->unmapPage(vpn);
+  }
+  ArchMemory::flushTlb();
+  heap_size_ = size;
+}
