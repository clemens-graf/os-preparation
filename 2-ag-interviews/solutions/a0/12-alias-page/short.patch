+#include "ScopeLock.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -114,6 +115,26 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_get_physical_address:
+    {
+      ScopeLock lock(process->getThreadLock());
+      ArchMemoryMapping m = process->getAddressSpace().resolveMapping(arg1 / PAGE_SIZE);
+      return_value = (arg1 < USER_BREAK && m.page_size == PAGE_SIZE) ? m.page_ppn : (size_t) -1;
+      break;
+    }
+    case sc_map_address:
+    {
+      ScopeLock lock(process->getThreadLock());
+      ArchMemory& memory = process->getAddressSpace();
+      // only below USER_BREAK, only a frame this process already has, only a free virtual page
+      if (arg1 >= USER_BREAK || !memory.mapsPhysicalPage(arg2) || !memory.mapPage(arg1 / PAGE_SIZE, arg2, 1))
+      {
+        return_value = -1;
+        break;
+      }
+      process->alias_vpns_.push_back(arg1 / PAGE_SIZE);
+      break;
+    }
     case sc_pthread_join:
       return_value = pthreadJoin(arg1, (void**)arg2);
       break;
