   return true;
 }
 
-bool ArchMemory::unmapPage(uint64 virtual_page)
+bool ArchMemory::unmapPage(uint64 virtual_page, bool free_physical_page)
 {
   ArchMemoryMapping m = resolveMapping(virtual_page);
 
   assert(m.page_ppn != 0 && m.page_size == PAGE_SIZE && m.pt[m.pti].present);
   m.pt[m.pti].present = 0;
-  PageManager::instance()->freePPN(m.page_ppn);
+  if (free_physical_page)
+    PageManager::instance()->freePPN(m.page_ppn);
   ((uint64*)m.pt)[m.pti] = 0; // for easier debugging
   bool empty = checkAndRemove<PageTableEntry>(getIdentAddressOfPPN(m.pt_ppn), m.pti);
   if (empty)
@@ -360,3 +361,30 @@ void ArchMemory::flushTlb()
 {
   asm volatile ("movq %%cr3, %%rax; movq %%rax, %%cr3;" ::: "%rax", "memory");
 }
+
+bool ArchMemory::mapsPhysicalPage(size_t ppn)
+{
+  PageMapLevel4Entry* pml4 = (PageMapLevel4Entry*) getIdentAddressOfPPN(page_map_level_4_);
+  for (size_t i4 = 0; i4 < PAGE_MAP_LEVEL_4_ENTRIES / 2; i4++)
+  {
+    if (!pml4[i4].present)
+      continue;
+    PageDirPointerTableEntry* pdpt = (PageDirPointerTableEntry*) getIdentAddressOfPPN(pml4[i4].page_ppn);
+    for (size_t i3 = 0; i3 < PAGE_DIR_POINTER_TABLE_ENTRIES; i3++)
+    {
+      if (!pdpt[i3].pd.present)
+        continue;
+      PageDirEntry* pd = (PageDirEntry*) getIdentAddressOfPPN(pdpt[i3].pd.page_ppn);
+      for (size_t i2 = 0; i2 < PAGE_DIR_ENTRIES; i2++)
+      {
+        if (!pd[i2].pt.present)
+          continue;
+        PageTableEntry* pt = (PageTableEntry*) getIdentAddressOfPPN(pd[i2].pt.page_ppn);
+        for (size_t i1 = 0; i1 < PAGE_TABLE_ENTRIES; i1++)
+          if (pt[i1].present && pt[i1].page_ppn == ppn)
+            return true;
+      }
+    }
+  }
+  return false;
+}
