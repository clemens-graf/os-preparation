+size_t Syscall::getPhysicalAddress(size_t address)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+  UserProcess* process = currentThread->getProcess();
+
+  process->getThreadLock().acquire();
+  ArchMemoryMapping m = process->getAddressSpace().resolveMapping(address / PAGE_SIZE);
+  // page_size == PAGE_SIZE: a 4 KiB page is mapped. Otherwise page_ppn is 0 - a real frame
+  // number, so "not mapped (yet)" must be -1.
+  size_t ppn = (size_t) -1;                 // not mapped
+  if (m.page_size == PAGE_SIZE)
+    ppn = m.page_ppn;
+  process->getThreadLock().release();
+  return ppn;
+}
+
+size_t Syscall::mapAddress(size_t address, size_t ppn)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+  size_t vpn = address / PAGE_SIZE;
+  UserProcess* process = currentThread->getProcess();
+
+  // ONE critical section: "the frame is mine" must still hold when it is mapped
+  process->getThreadLock().acquire();
+  bool mapped = false;
+  if (process->getAddressSpace().mapsPhysicalPage(ppn))                // only frames of this process
+    mapped = process->getAddressSpace().mapPage(vpn, ppn, 1);          // false: vpn already mapped
+  if (mapped)
+    process->addAlias(vpn);                                        // ~UserProcess unmaps it without free
+  process->getThreadLock().release();
+  if (!mapped)
+    return (size_t) -1;
+  return 0;
+}
