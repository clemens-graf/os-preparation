+// A0-06: handler == 0 unregisters
+size_t Syscall::setSegvHandler(size_t entry, size_t handler)
+{
+  if (entry == 0 || entry >= USER_BREAK || handler >= USER_BREAK)
+    return (size_t) -1;
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);
+  loader->segv_entry_ = entry;
+  loader->segv_handler_ = handler;
+  return 0;
+}
