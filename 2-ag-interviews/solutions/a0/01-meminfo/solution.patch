+// A0-01: must match struct meminfo in userspace/libc/include/nonstd.h
+struct MemInfo
+{
+  size_t total_pages;
+  size_t free_pages;
+  size_t process_pages;
+};
+
+size_t Syscall::memInfo(size_t user_info)
+{
+  if (user_info == 0 || user_info >= USER_BREAK - sizeof(MemInfo))
+    return (size_t) -1;
+
+  MemInfo info;
+  info.total_pages = PageManager::instance()->getTotalNumPages();
+  info.free_pages = PageManager::instance()->getNumFreePages();
+  {
+    Loader* loader = currentThread->loader_;
+    ScopeLock lock(loader->arch_memory_lock_);      // no thread may change the tables during the walk
+    info.process_pages = loader->arch_memory_.countUserPages();
+  }
+  *(MemInfo*) user_info = info;                     // one copy into user memory, after all locks are released
+  return 0;
+}
