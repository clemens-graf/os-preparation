@@ -89,6 +91,24 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_meminfo:
+    {
+      if (arg1 == 0 || arg1 > USER_BREAK - 3 * sizeof(size_t))   // the whole struct must be user memory
+      {
+        return_value = -1;
+        break;
+      }
+      size_t process_pages;
+      {
+        ScopeLock lock(process->getThreadLock());
+        process_pages = process->getAddressSpace().countUserPages();
+      }
+      size_t* info = (size_t*) arg1;                             // user memory: only without the lock
+      info[0] = PageManager::instance()->getTotalNumPages();
+      info[1] = PageManager::instance()->getNumFreePages();
+      info[2] = process_pages;
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
