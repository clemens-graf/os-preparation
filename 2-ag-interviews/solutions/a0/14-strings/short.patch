-}
\ No newline at end of file
+}
+
+char *strcpy(char *destination, const char *source)
+{
+  size_t i = 0;
+  for (; source[i] != '\0'; i++)
+    destination[i] = source[i];
+  destination[i] = '\0';
+  return destination;
+}
+
+char *strncpy(char *destination, const char *source, size_t n)
+{
+  size_t i = 0;
+  for (; i < n && source[i] != '\0'; i++)
+    destination[i] = source[i];
+  for (; i < n; i++)                         // the rest of the n bytes: zeros (no NUL if source was long)
+    destination[i] = '\0';
+  return destination;
+}
+
+char *strcat(char *destination, const char *source)
+{
+  strcpy(destination + strlen(destination), source);   // copy to where the old NUL is
+  return destination;
+}
+
+int strncmp(const char *first, const char *second, size_t n)
+{
+  for (size_t i = 0; i < n; i++)
+  {
+    if (first[i] != second[i])
+      return (unsigned char) first[i] - (unsigned char) second[i];
+    if (first[i] == '\0')
+      return 0;                              // both ended here
+  }
+  return 0;
+}
+
+char *strchr(const char *str, int character)
+{
+  for (size_t i = 0; ; i++)
+  {
+    if (str[i] == (char) character)
+      return (char *) &str[i];               // also finds the NUL if character == 0
+    if (str[i] == '\0')
+      return 0;
+  }
+}
