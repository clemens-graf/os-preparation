+}
+
+
+// A0-14: pure user-space C - no syscall, nothing in the kernel
+char *strcpy(char *destination, const char *source)
+{
+  char *d = destination;
+  while ((*d++ = *source++))               // copies the NUL too, then stops
+    ;
+  return destination;
+}
+
+char *strncpy(char *destination, const char *source, size_t n)
+{
+  size_t i = 0;
+  for (; i < n && source[i]; ++i)          // at most n bytes of source ...
+    destination[i] = source[i];
+  for (; i < n; ++i)                       // ... the rest of the n bytes: 0 (POSIX).
+    destination[i] = 0;                    // source longer than n: NO terminating NUL!
+  return destination;
+}
+
+char *strcat(char *destination, const char *source)
+{
+  strcpy(destination + strlen(destination), source);   // copy to the old end
+  return destination;
+}
+
+int strncmp(const char *first, const char *second, size_t n)
+{
+  for (size_t i = 0; i < n; ++i)
+  {
+    unsigned char a = (unsigned char) first[i], b = (unsigned char) second[i];
+    if (a != b)
+      return a < b ? -1 : 1;
+    if (a == 0)
+      return 0;                            // both ended here: equal - never read further
+  }
+  return 0;
+}
+
+char *strchr(const char *str, int character)
+{
+  for (;; ++str)
+  {
+    if (*str == (char) character)
+      return (char*) str;                  // also finds the NUL if character == 0
+    if (*str == 0)
+      return 0;
+  }
+}
