@@ -0,0 +1,26 @@
+#pragma once
+
+#include "Thread.h"
+
+class UserProcess;
+
+/**
+ * A0-08: an additional thread of a user process. Shares the address space (loader_)
+ * with the main thread, has its own user stack and its own registers.
+ */
+class UserThread : public Thread
+{
+  public:
+    UserThread(UserProcess* process, size_t stack_slot, size_t entry, size_t start_routine, size_t argument);
+
+    virtual ~UserThread();
+
+    virtual void Run(); // not used: user threads start in user space
+
+    size_t getThreadId() const;
+
+  private:
+    size_t stack_slot_;  // also used as the thread id
+
+    size_t stackTop() const;
+};
