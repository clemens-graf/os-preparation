diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index 178fc3a2..53138a9c 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -9,6 +9,7 @@
 #include "Scheduler.h"
 #include "UserProcess.h"
 #include "UserThread.h"
+#include "kstring.h"
 
 #define PTHREAD_CREATE_ERROR -1
 #define PTHREAD_JOIN_ERROR -1
@@ -89,6 +90,48 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pthread_equal:
       return_value = pthreadEqual((size_t)arg1, (size_t)arg2);
       break;
+    case sc_setnote:
+    {
+      char note[16] = {};                        // copy first: a refused string must not change the note
+      size_t length = 0;
+      bool ok = arg1 != 0;
+      while (ok && length < 15)
+      {
+        if (arg1 + length >= USER_BREAK)
+          ok = false;                            // the string runs into the kernel half
+        else if (((char*) arg1)[length] == '\0')
+          break;
+        else
+        {
+          note[length] = ((char*) arg1)[length];
+          length++;
+        }
+      }
+      if (!ok)
+      {
+        return_value = -1;
+        break;
+      }
+      memcpy(((UserThread*) currentThread)->note_, note, 16);
+      return_value = length;
+      break;
+    }
+    case sc_getnote:
+    {
+      char* note = ((UserThread*) currentThread)->note_;
+      if (arg1 == 0 || arg2 == 0 || arg2 > USER_BREAK || arg1 > USER_BREAK - arg2)
+      {
+        return_value = -1;                       // NULL, size 0, or the buffer reaches the kernel half
+        break;
+      }
+      size_t length = strlen(note);
+      size_t n = length < arg2 - 1 ? length : arg2 - 1;
+      for (size_t i = 0; i < n; i++)
+        ((char*) arg1)[i] = note[i];
+      ((char*) arg1)[n] = '\0';
+      return_value = length;                     // the full length, also if it was cut
+      break;
+    }
     case sc_execv:
       return_value = execv((const char*) arg1, (char* const*) arg2);
       break;
