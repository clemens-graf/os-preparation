+++ b/userspace/libc/src/stdlib.c
@@ -9,9 +9,29 @@ void free(void *ptr)
 {
 }
 
+// A1-14: the registered functions; exit() calls them in reverse order
+#define ATEXIT_MAX 32
+static void (*atexit_functions[ATEXIT_MAX])(void);
+static int atexit_count = 0;
+
 int atexit(void (*function)(void))
 {
-  return -1;
+  if (function == 0 || atexit_count == ATEXIT_MAX)
+    return -1;
+  atexit_functions[atexit_count] = function;
+  atexit_count++;
+  return 0;
+}
+
+// A1-14: called by exit() - not by _exit()
+void __runAtexitFunctions(void)
+{
+  while (atexit_count > 0)
+  {
+    atexit_count--;                                        // take it off first: if the function
+    void (*function)(void) = atexit_functions[atexit_count];   // calls exit() itself, that exit()
+    function();                                            // continues with the remaining ones
+  }
 }
 
