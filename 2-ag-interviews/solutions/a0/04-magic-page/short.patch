@@ -72,6 +75,19 @@ inline void PageFaultHandler::handlePageFault(size_t address, bool user,
 
   if (checkPageFaultIsValid(address, user, present, switch_to_us))
   {
+    if (address / PAGE_SIZE == 0xC0FFEE000 / PAGE_SIZE)          // A0-04: the magic page
+    {
+      size_t ppn = PageManager::instance()->allocPPN();          // a zeroed frame
+      char* page = (char*) ArchMemory::getIdentAddressOfPPN(ppn); // the kernel's address of it
+      strncpy(page, "coffee for ", PAGE_SIZE);
+      strncat(page, currentThread->getProcess()->getFileName().c_str(), PAGE_SIZE - strlen(page) - 1);
+      ArchMemory& memory = currentThread->getProcess()->getAddressSpace();
+      bool mapped = memory.mapPage(address / PAGE_SIZE, ppn, 1);
+      assert(mapped);
+      ArchMemoryMapping m = memory.resolveMapping(address / PAGE_SIZE);
+      m.pt[m.pti].writeable = 0;                                 // read-only: every write faults again -> killed
+      return;
+    }
