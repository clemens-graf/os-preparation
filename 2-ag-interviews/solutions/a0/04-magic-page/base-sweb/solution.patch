+bool Loader::mapReadOnlyPage(size_t vpn, size_t ppn)
+{
+  ScopeLock lock(arch_memory_lock_);
+  if (!arch_memory_.mapPage(vpn, ppn, 1))   // mapPage always maps writable ...
+    return false;
+  // ... so clear the bit before releasing the lock: no other thread of this process
+  // may ever see (and write to) the page while it is still writable
+  ArchMemoryMapping m = arch_memory_.resolveMapping(vpn);
+  m.pt[m.pti].writeable = 0;
+  return true;                              // not present before -> not in the TLB -> no flush needed
+}
