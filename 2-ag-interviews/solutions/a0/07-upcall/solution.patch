+// A0-07: let the thread call function(argument) and then continue after the syscall.
+// We fake what a "call function" instruction would have done at the point of the syscall:
+// push the return address (the instruction after int $0x80) and jump to function.
+size_t Syscall::upcall(size_t function, size_t argument)
+{
+  if (function == 0 || function >= USER_BREAK)
+    return (size_t) -1;
+
+  ArchThreadRegisters* regs = currentThread->user_registers_;
+  size_t rsp = ((regs->rsp - 128) & ~0xFULL) - sizeof(size_t); // red zone, alignment, return address slot
+
+  UserProcess* process = currentThread->getProcess();
+  {
+    ScopeLock lock(process->getThreadLock());
+    pointer slot = process->getAddressSpace().checkAddressValid(rsp);  // is that stack slot mapped?
+    if (!slot)
+      return (size_t) -1;
+    *(size_t*) slot = regs->rip;   // write via the ident mapping: cannot page fault here
+  }
+  regs->rsp = rsp;
+  regs->rip = function;
+  regs->rdi = argument;
+  // our return value lands in rax and is overwritten by function's return value -
+  // which is exactly what upcall() returns in user space
+  return 0;
+}
