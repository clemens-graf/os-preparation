diff --git a/userspace/libc/src/nonstd.c b/userspace/libc/src/nonstd.c
index 4c40ec43..637be9b2 100644
--- a/userspace/libc/src/nonstd.c
+++ b/userspace/libc/src/nonstd.c
@@ -29,3 +29,8 @@ unsigned long getUsedKernelMemory(void)
 {
   return __syscall(sc_get_used_kernel_memory, 0x00, 0x00, 0x00, 0x00, 0x00);
 }
+
+size_t upcall(size_t (*function)(size_t), size_t argument)
+{
+  return __syscall(sc_upcall, (size_t) function, argument, 0x00, 0x00, 0x00);
+}
