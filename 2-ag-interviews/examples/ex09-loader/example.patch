+
+// EX09: copy the program's segment list to user space
+size_t Syscall::segments(size_t user_array, size_t max)
+{
+  if (max == 0 || max > 16)
+    return (size_t) -1;
+  size_t bytes = max * sizeof(SegmentInfo);
+  if (user_array == 0 || user_array >= USER_BREAK - bytes)
+    return (size_t) -1;
+
+  SegmentInfo info[16];                                   // kernel copy first ...
+  size_t count = currentThread->loader_->getSegments(info, max);
+  memcpy((void*) user_array, info, count * sizeof(SegmentInfo)); // ... then one copy to user space
+  return count;
+}
