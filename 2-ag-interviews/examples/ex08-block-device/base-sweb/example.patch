 }
 
+
+Mutex* Syscall::disk_note_lock_ = nullptr;
+
+// EX08: read or write the first block of the swap partition (idea2)
+size_t Syscall::diskNote(size_t write, size_t user_buffer)
+{
+  BDVirtualDevice* device = BDManager::getInstance()->getDeviceByName("idea2");
+  if (!device)
+    return (size_t) -1;
+  size_t block_size = device->getBlockSize();          // 512 bytes
+  if (user_buffer == 0 || user_buffer >= USER_BREAK - block_size)
+    return (size_t) -1;
+
+  // the driver gets a kernel buffer, never the user pointer directly
+  char* block = new char[block_size];
+  int32 result;
+  {
+    ScopeLock lock(*disk_note_lock_);                  // read-modify-write of the block must not interleave
+    if (write)
+    {
+      memcpy(block, (char*) user_buffer, block_size);
+      result = device->writeData(0, block_size, block);   // offset and size in bytes, multiples of block_size
+    }
+    else
+    {
+      result = device->readData(0, block_size, block);
+      memcpy((char*) user_buffer, block, block_size);
+    }
+  }
+  delete[] block;
+  return result == (int32) block_size ? 0 : (size_t) -1;
+}
