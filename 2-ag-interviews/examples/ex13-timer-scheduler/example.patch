+// EX13: the same layout as TimesInfo in userspace/libc/include/nonstd.h (the kernel cannot include
+// libc headers - so the struct is written twice, field by field the same)
+struct TimesInfo
+{
+  size_t ticks_running;
+  size_t times_picked;
+};
+
+// EX13: read values the timer interrupt and the scheduler wrote.
+// Each is one aligned machine word: reading it is atomic - no lock needed (and none possible:
+// the writers run with interrupts off).
+size_t Syscall::timesInfo(size_t user_info)
+{
+  if (user_info == 0 || user_info >= USER_BREAK - sizeof(TimesInfo))
+    return (size_t) -1;
+
+  TimesInfo info;
+  info.ticks_running = currentThread->ticks_running_;
+  info.times_picked = currentThread->times_picked_;
+  memcpy((void*) user_info, &info, sizeof(info));
+  return 0;
+}
+
+// EX13: a flag the scheduler reads. Only the thread itself writes it - one word, no lock.
+size_t Syscall::lowPriority(size_t on)
+{
+  if (on > 1)
+    return (size_t) -1;
+  currentThread->low_priority_ = on;
+  return 0;
+}
+
 size_t Syscall::getThreadCount()
 {
   return Scheduler::instance()->getThreadCount();
