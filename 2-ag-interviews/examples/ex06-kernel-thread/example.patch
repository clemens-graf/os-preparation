diff --git a/common/include/kernel/TickerThread.h b/common/include/kernel/TickerThread.h
new file mode 100644
index 0000000..cf054b2
--- /dev/null
+++ b/common/include/kernel/TickerThread.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "Thread.h"
+
+class Mutex;
+class Condition;
+
+/**
+ * EX06: a kernel thread. It prints "tick" count times, every 5 timer ticks,
+ * then tells the waiting syscall that it is done.
+ */
+class TickerThread : public Thread
+{
+  public:
+    TickerThread(size_t count, Mutex* lock, Condition* done_condition, bool* done);
+
+    void Run() override;
+
+  private:
+    size_t count_;
+    Mutex* lock_;                // these three belong to the waiting syscall (its kernel stack)
+    Condition* done_condition_;
+    bool* done_;
+};
