@@ -181,3 +188,24 @@ void Syscall::trace()
   currentThread->printBacktrace();
 }
 
+
+// EX01: a syscall without arguments - just return a value (it ends up in the user's rax)
+size_t Syscall::getTicks()
+{
+  return Scheduler::instance()->getTicks();
+}
+
+// EX01: a syscall that writes into a user buffer.
+// Never trust a pointer from user space: it must lie completely below USER_BREAK,
+// and addr + size must not wrap around.
+size_t Syscall::getThreadName(size_t user_buffer, size_t size)
+{
+  if (user_buffer == 0 || size == 0 || size > USER_BREAK || user_buffer >= USER_BREAK - size)
+    return (size_t) -1; // NOT -1U: that is 0xFFFFFFFF, which user space does not see as -1
+
+  const char* name = currentThread->getName();
+  size_t length = ustl::min(strlen(name), size - 1);
+  memcpy((char*) user_buffer, name, length); // user memory is directly accessible: same address space
+  ((char*) user_buffer)[length] = '\0';
+  return length;
+}
