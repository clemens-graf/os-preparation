 size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2, size_t arg3, size_t arg4, size_t arg5)
 {
@@ -49,6 +50,9 @@ size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2
     case sc_pseudols:
       pseudols((const char*) arg1, (char*) arg2, arg3);
       break;
+    case sc_jump:
+      return_value = jump(arg1, arg2);
+      break;
     default:
       return_value = -1;
       kprintf("Syscall::syscallException: Unimplemented Syscall Number %zd\n", syscall_number);
@@ -181,3 +185,24 @@ void Syscall::trace()
   currentThread->printBacktrace();
 }
 
+
+// EX05: continue the user thread somewhere else.
+// user_registers_ holds the user state saved when the thread entered the kernel (int 0x80).
+// When the syscall returns, arch_contextSwitch() loads exactly these registers again -
+// so whatever we write into them is where and how the thread continues.
+size_t Syscall::jump(size_t function, size_t argument)
+{
+  if (function >= USER_BREAK)
+    return (size_t) -1;
+
+  ArchThreadRegisters* regs = currentThread->user_registers_;
+  size_t rsp = regs->rsp - 128;   // leave the red zone alone: leaf functions keep locals below rsp
+  rsp &= ~0xFULL;                 // System V ABI: rsp is 16-byte aligned before a call ...
+  rsp -= sizeof(size_t);          // ... and the call pushes an 8 byte return address
+  *(size_t*) rsp = 0;             // that return address: if function returns, it faults at 0
+
+  regs->rsp = rsp;
+  regs->rip = function;
+  regs->rdi = argument;           // first argument register of the System V ABI
+  return 0;                       // ends up in rax - the new function ignores it
+}
