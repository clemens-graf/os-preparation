+bool Loader::mapZeroPage(size_t vpn)
+{
+  size_t ppn = PageManager::instance()->allocPPN(); // allocate outside the lock: keeps the critical section short
+  arch_memory_lock_.acquire();
+  bool mapped = arch_memory_.mapPage(vpn, ppn, 1);
+  arch_memory_lock_.release();
+  if (!mapped)
+    PageManager::instance()->freePPN(ppn);          // somebody else was faster - give the page back
+  return mapped;
+}
