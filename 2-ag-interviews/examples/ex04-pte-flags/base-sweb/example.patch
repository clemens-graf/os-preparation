+
+// EX04: change a bit in the page table entry of an existing mapping
+size_t Syscall::protectPage(size_t address, size_t writable)
+{
+  if (address >= USER_BREAK)
+    return (size_t) -1;
+
+  Loader* loader = currentThread->loader_;
+  ScopeLock lock(loader->arch_memory_lock_);   // released automatically at every return
+
+  ArchMemoryMapping m = loader->arch_memory_.resolveMapping(address / PAGE_SIZE);
+  if (m.page_size != PAGE_SIZE)                // not mapped (yet) - m.pt may even be null
+    return (size_t) -1;
+
+  m.pt[m.pti].writeable = writable ? 1 : 0;
+  ArchMemory::flushTlb();                      // the CPU may still cache the old entry in its TLB
+  return 0;
+}
