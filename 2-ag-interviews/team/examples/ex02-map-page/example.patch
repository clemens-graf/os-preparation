+// EX02: map one page for the user at a fixed address (idempotent).
+#define SCRATCH_PAGE_ADDRESS 0x0000700000000000ULL
+
+size_t Syscall::scratchPage()
+{
+  Loader* loader = currentThread->getLoader();
+  size_t vpn = SCRATCH_PAGE_ADDRESS / PAGE_SIZE;
+
+  // 1. get a physical page (PageManager hands it out zeroed)
+  size_t ppn = PageManager::instance()->allocPPN();
+
+  // 2. fill it through the ident mapping: every physical page is visible to the kernel
+  //    at IDENT_MAPPING_START + ppn * PAGE_SIZE, independent of the current page tables
+  char* kernel_view = (char*) ArchMemory::getIdentAddressOfPPN(ppn);
+  const char greeting[] = "hello from the kernel";
+  memcpy(kernel_view, greeting, sizeof(greeting)); // strcpy is banned in SWEB (it asserts)
+
+  // 3. map it into the process (user_access = 1, otherwise only the kernel could use it)
+  loader->arch_memory_lock_.acquire();
+  bool mapped = loader->arch_memory_.mapPage(vpn, ppn, 1);
+  loader->arch_memory_lock_.release();
+
+  if (!mapped)                                 // already mapped by an earlier call:
+    PageManager::instance()->freePPN(ppn);     // keep the old page, give ours back
+  return SCRATCH_PAGE_ADDRESS;
+}
