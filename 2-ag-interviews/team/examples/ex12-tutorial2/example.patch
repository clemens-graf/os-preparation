+size_t Syscall::get_physical_address(size_t virtual_address)
+{
+  Loader* loader = currentThread->getLoader();
+
+  ArchMemoryMapping m = loader->arch_memory_.resolveMapping(virtual_address >> 12);
+  return m.page_ppn;
+}
+
+void Syscall::map_address(size_t virtual_address, size_t ppn)
+{
+  Loader* loader = currentThread->getLoader();
+
+  bool mapped = loader->arch_memory_.mapPage(virtual_address >> 12, ppn, 1);
+  assert(mapped);
+}
