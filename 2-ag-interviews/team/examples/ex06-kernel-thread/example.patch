 }
 
+// EX06: start a kernel thread and sleep until it is finished
+size_t Syscall::ticker(size_t count)
+{
+  if (count == 0 || count > 20)
+    return (size_t) -1;
+
+  Mutex lock("Syscall::ticker lock");
+  Condition done_condition(&lock, "Syscall::ticker done_condition");
+  bool done = false;
+
+  Scheduler::instance()->addNewThread(new TickerThread(count, &lock, &done_condition, &done));
+
+  lock.acquire();
+  while (!done)               // while, not if: re-check the state after every wake-up
+    done_condition.wait();    // releases lock while sleeping, holds it again afterwards
+  lock.release();
+  return count;
+}
+
 size_t Syscall::getThreadCount()
 {
   return Scheduler::instance()->getThreadCount();
diff --git a/common/source/kernel/TickerThread.cpp b/common/source/kernel/TickerThread.cpp
new file mode 100644
index 00000000..d568b5cd
--- /dev/null
+++ b/common/source/kernel/TickerThread.cpp
@@ -0,0 +1,29 @@
+#include "TickerThread.h"
+#include "Scheduler.h"
+#include "Mutex.h"
+#include "Condition.h"
+#include "kprintf.h"
+
+TickerThread::TickerThread(size_t count, Mutex* lock, Condition* done_condition, bool* done) :
+    Thread(0, "TickerThread", Thread::KERNEL_THREAD), count_(count), lock_(lock),
+    done_condition_(done_condition), done_(done)
+{
+}
+
+void TickerThread::Run()
+{
+  for (size_t i = 1; i <= count_; ++i)
+  {
+    size_t until = Scheduler::instance()->getTicks() + 5;
+    while (Scheduler::instance()->getTicks() < until)
+      Scheduler::instance()->yield();          // a kernel thread must give the CPU away itself
+    debug(TICKER, "tick %zu/%zu\n", i, count_);
+  }
+
+  lock_->acquire();
+  *done_ = true;                               // change the state ...
+  done_condition_->signal();                   // ... and signal while holding the mutex
+  lock_->release();
+  // From here on lock_, done_condition_ and done_ may already be gone (the waiter returned).
+  // Run() returns -> threadStartHack calls kill() -> the CleanupThread deletes this object.
+}
