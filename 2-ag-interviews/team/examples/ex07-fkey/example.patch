 Console* main_console;
 
@@ -47,6 +49,13 @@ void Console::handleKey(uint32 key)
 // else...
   switch (key)
   {
+    case KEY_F8:
+      // EX07: we are in the Console kernel thread here - NOT in the user process.
+      // Only set a flag; the next syscall does the actual work in the right context.
+      ArchThreads::testSetLock(Syscall::f8_pending_, 1);
+      debug(FKEY, "F8 pressed\n");
+      break;
+
     case KEY_F9:
       PageManager::instance()->printBitmap();
       kprintfd("Used kernel memory: %zu\n", KernelMemoryManager::instance()->getUsedKernelMemory(true));
diff --git a/common/source/kernel/Syscall.cpp b/common/source/kernel/Syscall.cpp
index a23a1231..2545eb66 100644
--- a/common/source/kernel/Syscall.cpp
+++ b/common/source/kernel/Syscall.cpp
@@ -7,10 +7,19 @@
 #include "ProcessRegistry.h"
 #include "File.h"
 #include "Scheduler.h"
+#include "PageManager.h"
+#include "ArchThreads.h"
+
+size_t Syscall::f8_pending_ = 0;
 
 size_t Syscall::syscallException(size_t syscall_number, size_t arg1, size_t arg2, size_t arg3, size_t arg4, size_t arg5)
 {
   size_t return_value = 0;
+
+  // EX07: atomically read and clear the flag - only one syscall handles one key press
+  if (f8_pending_ && ArchThreads::testSetLock(f8_pending_, 0))
+    handleF8();
+
   if ((syscall_number != sc_sched_yield) && (syscall_number != sc_outline)) // no debug print because these might occur very often
   {
     debug(SYSCALL, "Syscall %zd called with arguments %zd(=%zx) %zd(=%zx) %zd(=%zx) %zd(=%zx) %zd(=%zx)\n",
@@ -232,3 +241,12 @@ bool Syscall::copyUserString(size_t path, char* kernel_buffer, size_t buffer_siz
   }
   return false;
 }
+
+// EX07: runs in the context of whichever user thread makes the next syscall:
+// its page tables are active, so its user memory and registers can be used safely here.
+void Syscall::handleF8()
+{
+  debug(FKEY, "F8 handled by %s: user rip %zx, user rsp %zx, %u free physical pages\n",
+        currentThread->getName(), currentThread->user_registers_->rip,
+        currentThread->user_registers_->rsp, PageManager::instance()->getNumFreePages());
+}
