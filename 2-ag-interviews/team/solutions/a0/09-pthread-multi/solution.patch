+// A0-09: one new thread runs functions[0](arguments[0]), functions[1](arguments[1]), ... in order
+#define PTHREAD_MULTI_MAX 16
+
+size_t Syscall::pthreadMulti(size_t thread_id, size_t functions, size_t arguments, size_t count, size_t entry)
+{
+  size_t bytes = count * sizeof(size_t);
+  if (count == 0 || count > PTHREAD_MULTI_MAX || thread_id == 0 || thread_id >= USER_BREAK - sizeof(size_t) ||
+      functions == 0 || functions >= USER_BREAK - bytes || arguments == 0 || arguments >= USER_BREAK - bytes ||
+      entry == 0 || entry >= USER_BREAK)
+    return (size_t) -1;
+
+  // copy the arrays NOW: after the syscall returns the caller may reuse or free them,
+  // while the new thread reads them much later
+  size_t function_copy[PTHREAD_MULTI_MAX];
+  size_t argument_copy[PTHREAD_MULTI_MAX];
+  memcpy(function_copy, (void*) functions, bytes);
+  memcpy(argument_copy, (void*) arguments, bytes);
+  for (size_t i = 0; i < count; ++i)
+  {
+    if (function_copy[i] == 0 || function_copy[i] >= USER_BREAK)
+      return (size_t) -1;
+  }
+  *(size_t*) thread_id = 0;
+
+  UserThread* thread = currentThread->getProcess()->createThread(entry, 0, 0);
+  if (!thread)
+    return (size_t) -1;
+  // not scheduled yet: nobody else can touch its stack or registers
+  thread->user_registers_->rdi = thread->pushToStack(function_copy, bytes);
+  thread->user_registers_->rsi = thread->pushToStack(argument_copy, bytes);
+  thread->user_registers_->rdx = count;
+  *(size_t*) thread_id = thread->getThreadId();
+  Scheduler::instance()->addNewThread(thread);
+  return 0;
+}
