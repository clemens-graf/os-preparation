+bool UserProcess::deliverSegv(ArchThreadRegisters* registers, size_t address)
+{
+  ScopeLock lock(loader_->arch_memory_lock_);
+  if (!segv_handler_)
+    return false;
+
+  // a "call" without a call instruction: below the red zone, 16-byte aligned minus 8
+  size_t rsp = ((registers->rsp - 128) & ~0xFULL) - sizeof(size_t);
+  if (registers->rsp >= USER_BREAK || rsp >= USER_BREAK)
+    return false;
+  pointer slot = loader_->arch_memory_.checkAddressValid(rsp);  // kernel (ident) address of that stack slot
+  if (!slot)
+    return false;            // stack not mapped (e.g. the fault WAS the stack): nothing can run
+
+  *(size_t*) slot = 0;       // fake return address; entry never returns anyway
+  registers->rsp = rsp;
+  registers->rip = segv_entry_;
+  registers->rdi = address;          // 1st argument: the faulting address
+  registers->rsi = segv_handler_;    // 2nd argument: the user's handler
+  segv_handler_ = 0;                 // one-shot: a fault inside the handler kills the process
+  return true;
+}
