+// A0-06: handler == 0 unregisters
+size_t Syscall::setSegvHandler(size_t entry, size_t handler)
+{
+  if (entry == 0 || entry >= USER_BREAK || handler >= USER_BREAK)
+    return (size_t) -1;
+  UserProcess* process = currentThread->getProcess();          // per-process state
+  ScopeLock lock(process->getThreadLock());
+  process->segv_entry_ = entry;
+  process->segv_handler_ = handler;
+  return 0;
+}
