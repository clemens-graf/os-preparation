+size_t Syscall::setNote(size_t string)
+{
+  if (string == 0 || string >= USER_BREAK)
+    return (size_t) -1;
+  UserThread* thread = (UserThread*) currentThread;   // syscalls come from user threads only
+
+  // The length is unknown, so a range check up front is impossible: check every byte
+  // before reading it. string < USER_BREAK and length <= 15: string + length cannot overflow.
+  char note[sizeof(thread->note_)];
+  size_t length = 0;
+  while (length < sizeof(note) - 1)
+  {
+    if (string + length >= USER_BREAK)
+      return (size_t) -1;                       // runs into the kernel half before its NUL
+    char c = ((const char*) string)[length];    // may page-fault: loads a lazy user page
+    if (c == '\0')
+      break;
+    note[length++] = c;
+  }
+  note[length] = '\0';                          // strncpy would not guarantee this
+
+  // only the kernel copy from here on - the user string may change meanwhile
+  memcpy(thread->note_, note, sizeof(note));
+  debug(NOTE, "%s: note is now \"%s\"\n", currentThread->getName(), note);
+  return length;
+}
+
+size_t Syscall::getNote(size_t buffer, size_t size)
+{
+  if (buffer == 0 || size == 0 || size > USER_BREAK || buffer > USER_BREAK - size)
+    return (size_t) -1;
+  UserThread* thread = (UserThread*) currentThread;
+  size_t length = strlen(thread->note_);
+  size_t n = ustl::min(length, size - 1);
+  memcpy((char*) buffer, thread->note_, n);
+  ((char*) buffer)[n] = '\0';
+  return length;
+}
